<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SysMonitor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysMonitor.App"
    xmlns:converters="using:SysMonitor.App.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <!-- The console's dictionaries, in the order they lean on each other: the faces and the palette, the
                     Fluent overrides, then the text styles, the stock controls and the instruments that use them.
                     Styles.xaml comes last: it maps the first generation's style names onto all of the above, and
                     an implicit style in it would beat the console's own, so it holds none. Each is merged here
                     and nowhere else, which is where the palette was measured to follow an element's theme - a well's
                     Dark, a shift switched while the app runs (ConsoleDictionaryTests). Sources are absolute: a
                     relative one, looked up during layout, is "not a valid absolute URI". -->
                <ResourceDictionary Source="ms-appx:///Styles/Console/Fonts.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Console/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Console/FluentOverrides.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Console/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Console/Controls.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Console/Instruments.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:PercentConverter x:Key="PercentConverter"/>
            <converters:GBConverter x:Key="GBConverter"/>
            <converters:MBConverter x:Key="MBConverter"/>
            <converters:BoolToPluggedInConverter x:Key="BoolToPluggedInConverter"/>
            <converters:BoolToChargingConverter x:Key="BoolToChargingConverter"/>
            <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter"/>
            <converters:BoolToScanButtonConverter x:Key="BoolToScanButtonConverter"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
            <converters:ScanButtonIconConverter x:Key="ScanButtonIconConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:GreaterThanOneConverter x:Key="GreaterThanOneConverter"/>
            <converters:IntToDoubleConverter x:Key="IntToDoubleConverter"/>
            <converters:CelsiusToFahrenheitConverter x:Key="CelsiusToFahrenheitConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:ScheduleToVisibilityConverter x:Key="ScheduleToVisibilityConverter"/>

            <!-- Wizard Step Converters -->
            <converters:IntEqualsOneToVisibilityConverter x:Key="IntEqualsOneToVisibilityConverter"/>
            <converters:IntEqualsTwoToVisibilityConverter x:Key="IntEqualsTwoToVisibilityConverter"/>
            <converters:IntEqualsThreeToVisibilityConverter x:Key="IntEqualsThreeToVisibilityConverter"/>
            <converters:IntEqualsFourToVisibilityConverter x:Key="IntEqualsFourToVisibilityConverter"/>
            <converters:IntEqualsFiveToVisibilityConverter x:Key="IntEqualsFiveToVisibilityConverter"/>
            <converters:IntEqualsSixToVisibilityConverter x:Key="IntEqualsSixToVisibilityConverter"/>
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
            <converters:BoolToSuccessGlyphConverter x:Key="BoolToSuccessGlyphConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToLockGlyphConverter x:Key="BoolToLockGlyphConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:DoubleToStringConverter x:Key="DoubleToStringConverter"/>
            <converters:BoolToMonitoringTextConverter x:Key="BoolToMonitoringTextConverter"/>
            <!-- A yes or no as a lamp state for StateBrush: good or failed, and selected or not. -->
            <converters:BoolToLampStateConverter x:Key="BoolToGoNoGoConverter" WhenTrue="Go" WhenFalse="NoGo"/>
            <converters:BoolToLampStateConverter x:Key="BoolToArmedConverter" WhenTrue="Armed" WhenFalse="Off"/>
            <converters:GameModeIconConverter x:Key="GameModeIconConverter"/>
            <converters:GameModeTextConverter x:Key="GameModeTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
