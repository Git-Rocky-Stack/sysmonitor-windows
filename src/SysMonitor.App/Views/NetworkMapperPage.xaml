<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.NetworkMapperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysMonitor.App.Views"
    xmlns:vm="using:SysMonitor.App.ViewModels"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <instruments:ViewHeader Grid.Row="0" Module="MAP" Index="29" Title="NETWORK MAPPER"
                                Description="Discover Devices On Your Local Network">
            <instruments:ViewHeader.Actions>
                <Button Command="{x:Bind ViewModel.ScanNetworkCommand}"
                        Style="{StaticResource ChromeCapButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource ScanButtonIconConverter}}" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToScanButtonConverter}}"/>
                    </StackPanel>
                </Button>
            </instruments:ViewHeader.Actions>
        </instruments:ViewHeader>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Network Info & Devices -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="0,0,16,16">

                    <!-- Local Network Info Section -->
                    <StackPanel Spacing="8">
                        <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                            <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                            <TextBlock Text="LOCAL NETWORK INFO" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Local IP" Style="{StaticResource CardSubtitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.LocalIpAddress, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Gateway" Style="{StaticResource CardSubtitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Gateway, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAC Address" Style="{StaticResource CardSubtitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.MacAddress, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Hostname" Style="{StaticResource CardSubtitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Hostname, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Scan Settings & Stats Section -->
                    <StackPanel Spacing="8">
                        <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                            <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                            <TextBlock Text="SCAN SETTINGS &amp; STATISTICS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Scan Settings -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Scan Subnet" Style="{StaticResource CardSubtitleStyle}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.ScanSubnet, Mode=TwoWay}" PlaceholderText="192.168.1"/>
                                        <TextBlock Grid.Column="1" Text=".x" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource SilverBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Stats -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.DevicesFound, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Devices" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveDevices, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource StateGoBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Active" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.RoutersFound, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource StateHoldBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Routers" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ComputersFound, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Computers" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Scan Progress -->
                    <Border Style="{StaticResource CardStyle}" Padding="12" Background="{ThemeResource Carbon750Brush}"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <instruments:BusyWell Title="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"/>
                            <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentTarget, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Devices List Section -->
                    <StackPanel Spacing="8">
                        <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                            <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                            <TextBlock Text="DISCOVERED DEVICES" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Padding="0" MinHeight="300">
                            <Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                                          Background="Transparent" SelectionMode="Single">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="12"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NetworkDeviceDisplay">
                                            <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="6" Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Background="{x:Bind DeviceTypeColor, Converter={StaticResource StringToBrushConverter}}" CornerRadius="8" Width="48" Height="48" VerticalAlignment="Center" Opacity="0.2">
                                                        <FontIcon Glyph="{x:Bind DeviceIcon}" Foreground="{x:Bind DeviceTypeColor, Converter={StaticResource StringToBrushConverter}}" FontSize="20"/>
                                                    </Border>

                                                    <!-- Device Info -->
                                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Hostname}" Style="{StaticResource CardTitleStyle}"/>
                                                        <TextBlock Text="{x:Bind IpAddress}" FontSize="12" Foreground="{ThemeResource StateExecBrush}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{x:Bind MacAddress}" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Response Time -->
                                                    <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="Latency" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind ResponseTimeText}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Status -->
                                                    <Border Grid.Column="3" Background="{x:Bind StatusColor, Converter={StaticResource StringToBrushConverter}}" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ArmedFgBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.DevicesFound, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE968;" FontSize="48" Foreground="{ThemeResource SilverMuteBrush}"/>
                                    <TextBlock Text="No devices discovered" FontSize="14" Foreground="{ThemeResource SilverBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Click 'SCAN' to discover devices" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Action Status -->
                    <Border Background="{x:Bind ViewModel.ActionStatusColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}" CornerRadius="8" Padding="16"
                            Visibility="{x:Bind ViewModel.HasActionStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0.9">
                        <TextBlock Text="{x:Bind ViewModel.ActionStatus, Mode=OneWay}" Foreground="{ThemeResource ArmedFgBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel - Device Details -->
            <Border Grid.Column="1" Background="{ThemeResource Carbon800Brush}" CornerRadius="8,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20" Spacing="16">
                        <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                            <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                            <TextBlock Text="DEVICE DETAILS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <!-- No Selection -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasSelectedDevice, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <FontIcon Glyph="&#xE946;" FontSize="48" Foreground="{ThemeResource SilverMuteBrush}"/>
                            <TextBlock Text="Select a device to view details" FontSize="13" Foreground="{ThemeResource SilverBrush}" Margin="0,12,0,0" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Device Selected -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasSelectedDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="16">
                            <!-- Basic Info -->
                            <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.Hostname, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PlatinumBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.DeviceType, Mode=OneWay}" Style="{StaticResource CardSubtitleStyle}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{x:Bind ViewModel.SelectedDevice.StatusColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.StatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ArmedFgBrush}"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IP Address" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.IpAddress, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource StateExecBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="MAC Address" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.MacAddress, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PlatinumBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Manufacturer" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.Manufacturer, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PlatinumBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Latency" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.ResponseTimeText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource StateGoBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <StackPanel Spacing="8">
                                <Button Command="{x:Bind ViewModel.ScanPortsCommand}" HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.IsPortScanning, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                                        <TextBlock Text="SCAN PORTS"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.RefreshDeviceCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="REFRESH INFO"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Port Scan Progress -->
                            <instruments:BusyWell Title="{x:Bind ViewModel.PortScanStatus, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsPortScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Open Ports -->
                            <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="OPEN PORTS" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SilverBrush}"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}" SelectionMode="None" MaxHeight="200">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PortDisplay">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Port}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Service}" FontSize="12" Foreground="{ThemeResource SilverBrush}"/>
                                                    <Border Grid.Column="2" Background="{x:Bind StatusColor, Converter={StaticResource StringToBrushConverter}}" CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="{ThemeResource ArmedFgBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock Text="No open ports found" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}"
                                               Visibility="{x:Bind ViewModel.OpenPorts.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
