<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.UserGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,0,24">

            <instruments:ViewHeader Module="GUIDE" Index="34" Title="USER'S GUIDE"
                                    Description="Complete Reference &amp; Documentation"/>

            <!-- ==================== GETTING STARTED ==================== -->
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="GETTING STARTED" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Welcome to STX.1 System Monitor" FontSize="18" FontWeight="Bold"
                               Foreground="{ThemeResource ArmedLitBrush}"/>

                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}" FontSize="14" LineHeight="24">
                        STX.1 System Monitor is your all-in-one Windows optimization and monitoring toolkit.
                        Designed with performance and simplicity in mind, it helps you keep your PC running
                        at peak efficiency.
                    </TextBlock>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tip 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource ArmedBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock TextWrapping="Wrap" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" Foreground="{ThemeResource ArmedFgBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource PlatinumBrush}">
                            <Run FontWeight="SemiBold">Dashboard</Run>
                            <Run> - Start here for a quick overview of your system's health and resources.</Run>
                        </TextBlock>

                        <!-- Tip 2 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource RailGoBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock TextWrapping="Wrap" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" Foreground="{ThemeResource ArmedFgBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource PlatinumBrush}">
                            <Run FontWeight="SemiBold">Quick Clean</Run>
                            <Run> - One click deletes temporary files and tells you how many it removed.</Run>
                        </TextBlock>

                        <!-- Tip 3 -->
                        <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource RailExecBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock TextWrapping="Wrap" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" Foreground="{ThemeResource ArmedFgBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource PlatinumBrush}">
                            <Run FontWeight="SemiBold">Settings</Run>
                            <Run> - Customize alerts, thresholds, and behaviors to match your preferences.</Run>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== FEATURE GUIDE ==================== -->
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="FEATURE GUIDE" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Monitoring Features -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerRedStyle}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource PlatinumBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Monitoring" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource ArmedLitBrush}"/>
                            <TextBlock Text="Real-time hardware insights" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE950; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">CPU Monitor</Run>
                                <Run> - Track processor usage, cores, and performance</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE7F4; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">GPU Monitor</Run>
                                <Run> - Graphics card stats and temperature</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE964; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">Memory</Run>
                                <Run> - RAM usage with optimization options</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xEDA2; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">Disk</Run>
                                <Run> - Storage space and drive health</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE774; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">Network</Run>
                                <Run> - Upload/download speeds in real-time</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE9CA; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">Temperature</Run>
                                <Run> - CPU/GPU thermal monitoring</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run Text="&#xE9D9; " FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ArmedLitBrush}"/>
                                <Run FontWeight="SemiBold">Performance</Run>
                                <Run> - App operation metrics and timing</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cleanup & Optimization -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailGoBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cleanup &amp; Optimization" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateGoBrush}"/>
                            <TextBlock Text="Reclaim disk space, clear traces, and control what runs at startup" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Directory Cleaner</Run>
                                <Run> - Remove temp files, cache, and junk</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Registry Cleaner</Run>
                                <Run> - Fix broken registry entries safely</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Browser Privacy</Run>
                                <Run> - Clear browsing data and cookies</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Startup Manager</Run>
                                <Run> - Control which apps run at boot</Run>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Drive Wiper</Run>
                                <Run> - Overwrites files before deleting them and reads the last pass back. It asks first, and nothing it wipes goes to the Recycle Bin</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Scheduled Cleaning</Run>
                                <Run> - Automate cleanup tasks</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Game Mode -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailGoBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Game Mode" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateGoBrush}"/>
                            <TextBlock Text="Advanced gaming optimization suite" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}" FontSize="13" LineHeight="22">
                        Game Mode is a gaming optimization suite with three features: Auto Game Mode,
                        Performance Profiles and the game overlay. It moves background apps out of the game's
                        way, switches the power plan, and shows what the machine is doing while you play.
                    </TextBlock>

                    <!-- Core Features -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Close Background Apps</Run>
                                <Run> - Asks browsers, Discord, Spotify and the rest to close, or just lowers their priority. Anything that declines keeps running.</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">High Performance Mode</Run>
                                <Run> - Sets Windows power plan automatically</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Trim Memory</Run>
                                <Run> - Trims the working sets of background apps. Windows can page them back, so this does not free RAM.</Run>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Session Stats</Run>
                                <Run> - Shows how many background apps were moved out of the way, which ones would not go, and how much was trimmed from their working sets</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Features -->
                    <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Advanced Features" FontWeight="SemiBold" Foreground="{ThemeResource PlatinumBrush}" FontSize="13"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource ArmedLitBrush}" FontSize="12">Auto Game Mode</TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                            Automatically enables Game Mode when games are detected. Includes 50+ predefined games plus custom game support.
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}" FontSize="12">Performance Profiles</TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                            Save and switch between optimization presets: Maximum Performance, Balanced Gaming, or Streaming Mode.
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}" FontSize="12">Game Overlay</TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                            Telemetry-style overlay showing CPU and GPU temperatures in Fahrenheit, usage %, RAM, power draw and fan speed. Frame rate too, on a GPU that reports it - the overlay says so when yours does not. Drag to reposition.
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System Monitoring -->
                    <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Text="Real-time System Monitoring" FontWeight="SemiBold" Foreground="{ThemeResource PlatinumBrush}" FontSize="13"/>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                        <Run FontWeight="SemiBold" Foreground="{ThemeResource StateGoBrush}">Fan Speeds</Run>
                                        <Run> - CPU and system fan RPM (requires hardware sensor support)</Run>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                        <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Power Draw</Run>
                                        <Run> - CPU, GPU, and total system wattage</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Target Apps Info -->
                    <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Apps Closed by Game Mode:" FontWeight="SemiBold" Foreground="{ThemeResource PlatinumBrush}" FontSize="12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="11">
                                Chrome, Firefox, Edge, Opera, Brave, Discord, Slack, Teams, Skype, Zoom, Telegram,
                                Spotify, iTunes, OneDrive, Dropbox, Google Drive Sync, Steam Web Helper
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Utilities -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailExecBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Utilities &amp; Tools" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateExecBrush}"/>
                            <TextBlock Text="Powerful productivity features" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">Large Files</Run>
                                <Run> - Finds the largest files. The ones you pick go to the Recycle Bin once you confirm</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">Duplicate Finder</Run>
                                <Run> - Finds files with identical contents. The copies you pick go to the Recycle Bin once you confirm</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">File Tools</Run>
                                <Run> - Compress to ZIP or GZip, and extract archives</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">PDF Tools</Run>
                                <Run> - Merge, split, convert PDFs</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">Image Tools</Run>
                                <Run> - Resize, compress, convert images</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}">Network Mapper</Run>
                                <Run> - Discover devices on your network</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Tray & Alerts -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailHoldBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Tray &amp; Alerts" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateHoldBrush}"/>
                            <TextBlock Text="Background monitoring with notifications" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}" FontSize="13" LineHeight="22">
                        STX.1 runs quietly in the system tray, providing live stats and alerts without interrupting your work.
                        Configure thresholds in Settings and receive toast notifications when temperatures or memory usage exceed limits.
                    </TextBlock>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Live Tooltip</Run>
                                <Run> - Hover over tray icon for CPU/RAM stats</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Minimize to Tray</Run>
                                <Run> - Close button hides to tray (configurable)</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Quick Menu</Run>
                                <Run> - Right-click tray icon for navigation</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Temperature Alerts</Run>
                                <Run> - CPU (167 F and 194 F) and GPU warnings</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Memory Alerts</Run>
                                <Run> - Notification when RAM exceeds 80%</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Smart Cooldown</Run>
                                <Run> - 5-minute delay prevents notification spam</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Historical Data & Graphs -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailHoldBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Historical Data &amp; Graphs" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateHoldBrush}"/>
                            <TextBlock Text="30-day performance trends" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}" FontSize="13" LineHeight="22">
                        The History page displays interactive charts showing CPU, Memory, and Temperature trends over time.
                        Data is automatically recorded every 30 seconds and stored locally for up to 30 days.
                    </TextBlock>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">CPU Usage Chart</Run>
                                <Run> - Track processor load over time</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Memory Chart</Run>
                                <Run> - Monitor RAM usage patterns</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Temperature Chart</Run>
                                <Run> - CPU and GPU thermal trends</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Time Ranges</Run>
                                <Run> - 1 hour, 24 hours, 7 days, 30 days</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Interactive Charts</Run>
                                <Run> - Zoom and pan with LiveCharts2</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Auto-Purge</Run>
                                <Run> - Old data cleaned automatically</Run>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Performance Monitoring -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconContainerStyle}" Background="{ThemeResource RailHoldBrush}" Width="40" Height="40">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource ArmedFgBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Performance Monitoring" FontSize="16" FontWeight="Bold"
                                       Foreground="{ThemeResource StateHoldBrush}"/>
                            <TextBlock Text="Track application operation metrics" FontSize="12"
                                       Foreground="{ThemeResource SilverBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource PlatinumBrush}" FontSize="13" LineHeight="22">
                        The Performance page provides real-time insights into how STX.1 System Monitor operates internally.
                        Monitor operation timing, identify bottlenecks, and export metrics for analysis.
                    </TextBlock>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">System Overview</Run>
                                <Run> - Memory usage, GC pressure, frame rate</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Operation Metrics</Run>
                                <Run> - Count, average, min, max timing</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Percentiles</Run>
                                <Run> - P95 and P99 latency tracking</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
                                <Run FontWeight="SemiBold" Foreground="{ThemeResource StateHoldBrush}">Status Indicators</Run>
                                <Run> - Excellent/Good/Fair/Poor/Critical</Run>
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource PlatinumBrush}">
