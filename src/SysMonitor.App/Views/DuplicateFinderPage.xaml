<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.DuplicateFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SysMonitor.App.ViewModels"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,24" Spacing="16">

            <!-- Page Header Banner -->
            <instruments:ViewHeader Module="DUPES" Index="23" Title="DUPLICATE FINDER"
                                    Description="Find and remove duplicate files"/>

            <!-- Scan Controls -->
            <instruments:Plate Padding="24" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Path Selection -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ScanPath, Mode=TwoWay}"
                                 PlaceholderText="Select folder to scan for duplicates..."/>
                        <Button Grid.Column="1" Content="BROWSE" Command="{x:Bind ViewModel.BrowseFolderCommand}"/>
                        <Button Grid.Column="2" Content="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToScanButtonConverter}}"
                                Command="{x:Bind ViewModel.ScanCommand}"
                                Style="{StaticResource ChromeCapButtonStyle}" Width="140"/>
                    </Grid>

                    <!-- Progress -->
                    <StackPanel Grid.Row="1" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                                     Maximum="100" Height="6" CornerRadius="3"
                                     Background="{ThemeResource Carbon700Brush}"
                                     Foreground="{ThemeResource ArmedBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </Grid>
            </instruments:Plate>

            <!-- Action Feedback -->
            <instruments:Well Padding="16"
                    Visibility="{x:Bind ViewModel.HasActionStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="20"
                              instruments:StateBrush.Foreground="{x:Bind ViewModel.ActionStatusState, Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActionStatus, Mode=OneWay}"
                               Foreground="{ThemeResource PlatinumBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>
            </instruments:Well>

            <!-- Stats Summary -->
            <instruments:Faceplate Kicker="DUPES - DUPLICATE ANALYSIS - 23A" Serial="{instruments:SerialFor Module=DUPES-DUPLICATE-ANALYSIS}">
                <StackPanel Spacing="16">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <instruments:Plate Grid.Column="0" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="DUPLICATE GROUPS" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.GroupsFound, Mode=OneWay}"
                                           Style="{StaticResource StatValueStyle}" Foreground="{ThemeResource StateExecBrush}"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="1" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="TOTAL DUPLICATES" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.TotalDuplicates, Mode=OneWay}"
                                           Style="{StaticResource StatValueStyle}" Foreground="{ThemeResource StateHoldBrush}"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="2" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="WASTED SPACE" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.WastedSpace, Mode=OneWay}"
                                           Style="{StaticResource StatValueStyle}" Foreground="{ThemeResource ArmedLitBrush}"/>
                            </StackPanel>
                        </instruments:Plate>
                    </Grid>

                    <!-- Action Buttons -->
                    <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="SELECT ALL DUPLICATES" Command="{x:Bind ViewModel.SelectAllDuplicatesCommand}"/>
                            <Button Content="SELECT NONE" Command="{x:Bind ViewModel.SelectNoneCommand}"/>
                            <Button Command="{x:Bind ViewModel.DeleteSelectedDuplicatesCommand}"
                                    Style="{StaticResource ArmedCapButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="DELETE SELECTED"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </instruments:Plate>
                </StackPanel>
            </instruments:Faceplate>

            <!-- Duplicate Groups List -->
            <instruments:Faceplate Kicker="DUPES - DUPLICATES FOUND - 23B" Serial="{instruments:SerialFor Module=DUPES-DUPLICATES-FOUND}">
                <StackPanel Spacing="16">

                    <instruments:Plate Padding="16" MinHeight="200" VerticalContentAlignment="Stretch">
                        <Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="16"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateGroupDisplay">
                                        <instruments:Well Padding="16">
                                            <StackPanel Spacing="12">
                                                <!-- Group Header -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                                        <Border Background="{ThemeResource RailHoldBrush}" CornerRadius="8"
                                                                Padding="8,4">
                                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                                       Foreground="{ThemeResource PlatinumBrush}">
                                                                <Run Text="{x:Bind DuplicateCount}"/>
                                                                <Run Text="DUPLICATES"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind FormattedSize}" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource SilverBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource ArmedLitBrush}" FontWeight="Bold">
                                                        <Run Text="Wasted:"/>
                                                        <Run Text="{x:Bind WastedSpace}"/>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Files in Group -->
                                                <ItemsRepeater ItemsSource="{x:Bind Files}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Vertical" Spacing="8"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DuplicateFileDisplay">
                                                            <Border Background="{ThemeResource Carbon700Brush}"
                                                                    CornerRadius="8" Padding="12">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox AutomationProperties.Name="{x:Bind FileName}" Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                              IsEnabled="{x:Bind IsOriginal, Converter={StaticResource InvertBoolConverter}}"
                                                                              VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource PlatinumBrush}"/>
                                                                        <TextBlock Text="{x:Bind Directory}" FontSize="11"
                                                                                   Foreground="{ThemeResource SilverBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="2" CornerRadius="6" Padding="10,4"
                                                                            VerticalAlignment="Center"
                                                                            instruments:StateBrush.Wash="{x:Bind StatusState}">
                                                                        <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="Bold"
                                                                                   instruments:StateBrush.Foreground="{x:Bind StatusState}"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </instruments:Well>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <!-- Before a scan, and after one that finds nothing, the plate says so rather than standing empty. -->
                            <TextBlock Text="No duplicates to show. Choose a folder and press SCAN; files that match byte for byte are listed here." Style="{StaticResource DescriptionTextStyle}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                                       Visibility="{x:Bind ViewModel.DuplicateGroups.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                        </Grid>
                    </instruments:Plate>
                </StackPanel>
            </instruments:Faceplate>

            <!-- Footer -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0">
                <Image Source="ms-appx:///Assets/Header_Main1.png"
                       Height="16" HorizontalAlignment="Center"
                       Stretch="Uniform" Opacity="0.7"/>
                <TextBlock Text="Powered by Strategia-X Technology"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource ArmedLitBrush}"
                           FontSize="12"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
