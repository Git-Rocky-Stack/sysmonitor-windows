<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SysMonitor.App.ViewModels"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,24" Spacing="16">

            <instruments:ViewHeader Module="PERF" Index="30" Title="PERFORMANCE"
                                    Description="Real-time application performance metrics"/>

            <!-- Monitoring Controls Section -->
            <StackPanel Spacing="12">
                <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                    <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                    <TextBlock Text="MONITORING CONTROLS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>

                <!-- Controls Card -->
                <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconContainerRedStyle}" Margin="0,0,16,0">
                            <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Status" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                <instruments:Chip State="{x:Bind ViewModel.IsMonitoring, Mode=OneWay, Converter={StaticResource BoolToGoHoldConverter}}"
                                                  Content="{x:Bind ViewModel.IsMonitoring, Mode=OneWay, Converter={StaticResource BoolToMonitoringWordConverter}}"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0">
                                <Run Text="Tracked Operations: "/>
                                <Run Text="{x:Bind ViewModel.Metrics.Count, Mode=OneWay}" Foreground="{ThemeResource StateHoldBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <!-- Pause/Resume -->
                            <Button Content="{x:Bind ViewModel.IsMonitoring, Mode=OneWay, Converter={StaticResource BoolToMonitoringTextConverter}}"
                                    Command="{x:Bind ViewModel.ToggleMonitoringCommand}"
                                    Style="{StaticResource ChromeCapButtonStyle}"/>
                            <!-- Clear -->
                            <Button Content="CLEAR" Command="{x:Bind ViewModel.ClearMetricsCommand}"/>
                            <!-- Export CSV -->
                            <Button Content="EXPORT CSV" Command="{x:Bind ViewModel.ExportMetricsCommand}"/>
                        </StackPanel>
                    </Grid>
                </instruments:Plate>
            </StackPanel>

            <!-- System Overview Section -->
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="SYSTEM OVERVIEW" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- System Stats Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Memory Usage Card -->
                <instruments:Plate Grid.Column="0" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource MenuCardIconStyle}">
                                <FontIcon Glyph="&#xE964;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                            </Border>
                            <TextBlock Text="MEMORY" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}">
                            <Run Text="{x:Bind ViewModel.MemoryUsageMB, Mode=OneWay, Converter={StaticResource DoubleToStringConverter}}"/>
                            <Run Text="MB" FontSize="14" Foreground="{ThemeResource SilverBrush}"/>
                        </TextBlock>
                        <TextBlock Text="Working Set" Style="{StaticResource MenuItemSubtitleStyle}" FontSize="11"/>
                    </StackPanel>
                </instruments:Plate>

                <!-- GC Pressure Card -->
                <instruments:Plate Grid.Column="1" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource MenuCardIconStyle}">
                                <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                            </Border>
                            <TextBlock Text="GC PRESSURE" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateGoBrush}">
                            <Run Text="{x:Bind ViewModel.GcPressure, Mode=OneWay, Converter={StaticResource DoubleToStringConverter}}"/>
                        </TextBlock>
                        <TextBlock Text="Collection Score" Style="{StaticResource MenuItemSubtitleStyle}" FontSize="11"/>
                    </StackPanel>
                </instruments:Plate>

                <!-- Metrics Count Card -->
                <instruments:Plate Grid.Column="2" Padding="16" MinWidth="200" MinHeight="100" VerticalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource MenuCardIconStyle}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                            </Border>
                            <TextBlock Text="TRACKED OPS" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{ThemeResource PlatinumBrush}">
                            <Run Text="{x:Bind ViewModel.Metrics.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Operations Monitored" Style="{StaticResource MenuItemSubtitleStyle}" FontSize="11"/>
                    </StackPanel>
                </instruments:Plate>
            </Grid>

            <!-- Performance Metrics Section -->
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="OPERATION METRICS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Metrics List -->
            <instruments:Plate Padding="0" VerticalContentAlignment="Stretch">
                <!-- Header Row -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource Carbon750Brush}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OPERATION" Style="{StaticResource StatLabelStyle}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="COUNT" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="AVG (ms)" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="MIN (ms)" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="MAX (ms)" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="P95 (ms)" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="P99 (ms)" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource StatLabelStyle}" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Metrics, Mode=OneWay}"
                              SelectionMode="None"
                              Background="Transparent"
                              MaxHeight="500">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PerformanceMetric">
                                <Border Padding="16,12" BorderBrush="{ThemeResource Carbon700Brush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Operation}"
                                                   Foreground="{ThemeResource PlatinumBrush}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Count}"
                                                   Foreground="{ThemeResource SilverBrush}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind AverageMsFormatted}"
                                                   Foreground="{ThemeResource StateExecBrush}" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind MinMsFormatted}"
                                                   Foreground="{ThemeResource StateGoBrush}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind MaxMsFormatted}"
                                                   Foreground="{ThemeResource StateHoldBrush}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind P95MsFormatted}"
                                                   Foreground="{ThemeResource SilverBrush}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind P99MsFormatted}"
                                                   Foreground="{ThemeResource SilverBrush}" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Border Grid.Column="7" Background="{ThemeResource RailGoBrush}"
                                                CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ArmedFgBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </instruments:Plate>

            <!-- Legend Section -->
            <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="PERFORMANCE THRESHOLDS" Style="{StaticResource StatLabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource RailGoBrush}" Width="16" Height="16" CornerRadius="4"/>
                            <TextBlock Text="Excellent (&lt;16ms)" Foreground="{ThemeResource SilverBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource RailGoBrush}" Width="16" Height="16" CornerRadius="4"/>
                            <TextBlock Text="Good (&lt;50ms)" Foreground="{ThemeResource SilverBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource RailHoldBrush}" Width="16" Height="16" CornerRadius="4"/>
                            <TextBlock Text="Fair (&lt;100ms)" Foreground="{ThemeResource SilverBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource RailWarnBrush}" Width="16" Height="16" CornerRadius="4"/>
                            <TextBlock Text="Poor (&lt;200ms)" Foreground="{ThemeResource SilverBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource RailNoGoBrush}" Width="16" Height="16" CornerRadius="4"/>
                            <TextBlock Text="Critical (&gt;200ms)" Foreground="{ThemeResource SilverBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </instruments:Plate>

            <!-- Info Section -->
            <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource StateExecBrush}"/>
                        <TextBlock Text="About Performance Monitoring" Foreground="{ThemeResource PlatinumBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="12" LineHeight="20">
                        This page displays real-time performance metrics for SysMonitor operations. Use the TrackOperation API in your code to monitor custom operations.
                        Metrics include execution count, average/min/max times, and P95/P99 percentiles. Export to CSV for detailed analysis.
                    </TextBlock>
                </StackPanel>
            </instruments:Plate>

        </StackPanel>
    </ScrollViewer>
</Page>