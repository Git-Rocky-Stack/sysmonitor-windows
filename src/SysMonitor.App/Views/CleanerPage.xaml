<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <instruments:ViewHeader Grid.Row="0" Module="CLEAN" Index="06" Title="DIRECTORY CLEANER"
                                Description="Remove Temporary Files &amp; Free Up Space"/>

        <!-- Cleaning Controls Section -->
        <StackPanel Grid.Row="1" Spacing="12">
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="CLEANING CONTROLS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Status Card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconContainerRedStyle}" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0">
                            <Run Text="Total: "/>
                            <Run Text="{x:Bind ViewModel.FormattedTotalSize, Mode=OneWay}" Foreground="{ThemeResource StateHoldBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="SCAN" Command="{x:Bind ViewModel.ScanCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"/>
                        <Button Content="CLEAN SELECTED" Command="{x:Bind ViewModel.CleanCommand}"
                                Style="{StaticResource ArmedCapButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Scan Results Section -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="SCAN RESULTS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Results List -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ScanResults, Mode=OneWay}"
                      Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,4,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>

                            <Border Grid.Column="1" Style="{StaticResource IconContainerStyle}"
                                    Width="40" Height="40" Margin="8,0,12,0">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource PlatinumBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CardSubtitleStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SilverBrush}">
                                <Run Text="{Binding FileCount}"/>
                                <Run Text=" files"/>
                            </TextBlock>

                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       Text="{Binding FormattedSize}"
                                       Foreground="{ThemeResource StateHoldBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Foreground="{ThemeResource ArmedBrush}"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>
