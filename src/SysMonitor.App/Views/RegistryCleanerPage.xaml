<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.RegistryCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <instruments:ViewHeader Grid.Row="0" Module="REG" Index="07" Title="REGISTRY CLEANER"
                                Description="Find &amp; Fix Invalid Registry Entries"/>

        <!-- Cleaning Controls Section -->
        <StackPanel Grid.Row="1" Spacing="12">
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="REGISTRY CONTROLS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Status Card -->
            <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconContainerRedStyle}" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xEA99;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0">
                            <Run Text="Issues: "/>
                            <Run Text="{x:Bind ViewModel.TotalIssues, Mode=OneWay}" Foreground="{ThemeResource StateHoldBrush}"/>
                            <Run Text=" | Selected: "/>
                            <Run Text="{x:Bind ViewModel.SelectedIssues, Mode=OneWay}" Foreground="{ThemeResource StateExecBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <!-- SCAN -->
                        <Button Content="SCAN" Command="{x:Bind ViewModel.ScanCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"/>
                        <!-- FIX SELECTED -->
                        <Button Content="FIX SELECTED" Command="{x:Bind ViewModel.CleanCommand}"
                                Style="{StaticResource ArmedCapButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}"/>
                        <!-- RESTORE BACKUP -->
                        <Button Content="RESTORE BACKUP" Click="RestoreBackup_Click"
                                ToolTipService.ToolTip="Undo the last registry cleaning by importing its backup"
                                IsEnabled="{x:Bind ViewModel.HasBackup, Mode=OneWay}"/>
                        <Button Command="{x:Bind ViewModel.OpenBackupFolderCommand}" Padding="10" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Open the registry backups folder"
                                AutomationProperties.Name="Open registry backups folder">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </instruments:Plate>

            <!-- Info Card -->
            <instruments:Plate Padding="12" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16"
                              Foreground="{ThemeResource StateExecBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource SilverBrush}" FontSize="12">
                        <Run Text="Registry cleaning removes invalid entries left behind by uninstalled programs. "/>
                        <Run Text="Every key that will change is backed up first; if the backup fails, nothing is changed. Use RESTORE BACKUP to undo the last cleaning." Foreground="{ThemeResource StateGoBrush}"/>
                    </TextBlock>
                </Grid>
            </instruments:Plate>
        </StackPanel>

        <!-- Scan Results Section -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="SCAN RESULTS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Results List -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ScanResults, Mode=OneWay}"
                      Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,4,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <instruments:Plate Padding="12" Opacity="{Binding IsProtected, Converter={StaticResource BoolToOpacityConverter}}" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBoolConverter}}"
                                      VerticalAlignment="Center"/>

                            <Border Grid.Column="1" Style="{StaticResource IconContainerStyle}"
                                    Width="40" Height="40" Margin="8,0,12,0">
                                <!-- Show lock icon if protected, registry icon otherwise -->
                                <FontIcon FontSize="16" Foreground="{ThemeResource PlatinumBrush}"
                                          Glyph="{Binding IsProtected, Converter={StaticResource BoolToLockGlyphConverter}}"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding IssueType}" Style="{StaticResource CardTitleStyle}"/>
                                    <!-- Protected badge -->
                                    <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource NoGoSoftBrush}"
                                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource StateNoGoBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CardSubtitleStyle}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource CardSubtitleStyle}"
                                           Foreground="{ThemeResource SilverMuteBrush}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                <!-- Protection reason -->
                                <TextBlock Text="{Binding ProtectionReason}" FontSize="10" Foreground="{ThemeResource StateWarnBrush}"
                                           Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Risk Level Badge -->
                            <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="8" Padding="8,4"
                                    Background="{ThemeResource Carbon700Brush}" Margin="8,0,0,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <Run Text="{Binding RiskLevel}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </instruments:Plate>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Foreground="{ThemeResource ArmedBrush}"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>
