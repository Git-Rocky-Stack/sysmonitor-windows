<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.WiFiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysMonitor.App.Views"
    xmlns:vm="using:SysMonitor.App.ViewModels"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <instruments:ViewHeader Grid.Row="0" Module="WIFI" Index="28" Title="WIFI ANALYZER"
                                Description="Scan &amp; Analyze WiFi Networks">
            <instruments:ViewHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- SCAN -->
                    <Button Command="{x:Bind ViewModel.ScanNetworksCommand}" IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}"
                            Style="{StaticResource ChromeCapButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="SCAN"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.StopScanCommand}"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="STOP"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </instruments:ViewHeader.Actions>
        </instruments:ViewHeader>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,0,16">

                <!-- Adapter & Connection Section -->
                <StackPanel Spacing="8">
                    <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                        <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                        <TextBlock Text="CONNECTION STATUS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Adapter Info -->
                        <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconContainerRedStyle}" Margin="0,0,16,0">
                                    <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AdapterName, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.MacAddress, Mode=OneWay}" Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <instruments:Chip State="{x:Bind ViewModel.AdapterStatusState, Mode=OneWay}" Content="{x:Bind ViewModel.AdapterStatus, Mode=OneWay, Converter={StaticResource UpperCaseConverter}}" Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </instruments:Plate>

                        <!-- Current Connection -->
                        <instruments:Plate Grid.Column="1" Padding="16" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Connected To" Style="{StaticResource CardSubtitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ConnectedNetwork, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                                                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.ConnectionChannel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ConnectionSpeed, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                               instruments:StateBrush.Foreground="{x:Bind ViewModel.ConnectionStatusState, Mode=OneWay}">
                                        <Run Text="{x:Bind ViewModel.ConnectionSignal, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock Text="Signal" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </instruments:Plate>
                    </Grid>
                </StackPanel>

                <!-- Stats Section -->
                <StackPanel Spacing="8">
                    <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                        <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                        <TextBlock Text="NETWORK STATISTICS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Networks" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.NetworksFound, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="1" Padding="16" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Secure" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.SecureNetworks, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateGoBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="2" Padding="16" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Open" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.OpenNetworks, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateHoldBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="3" Padding="16" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="2.4 GHz" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.Networks24GHz, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </instruments:Plate>

                        <instruments:Plate Grid.Column="4" Padding="16" VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="5 GHz" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.Networks5GHz, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </instruments:Plate>
                    </Grid>
                </StackPanel>

                <!-- Scan Status -->
                <instruments:BusyWell Title="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Permission Warning Banner -->
                <Border Background="{ThemeResource WarnSoftBrush}" BorderBrush="{ThemeResource RailWarnBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{x:Bind ViewModel.HasPermissionError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource StateWarnBrush}" VerticalAlignment="Top" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="WINDOWS PERMISSIONS REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource StateWarnBrush}"/>
                            <TextBlock Text="Windows 11 requires additional permissions to scan WiFi networks:"
                                       Foreground="{ThemeResource SilverBrush}" TextWrapping="Wrap"/>

                            <!-- Location Permission -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.RequiresLocationPermission, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE81D;" FontSize="16" Foreground="{ThemeResource StateHoldBrush}"/>
                                <TextBlock Foreground="{ThemeResource PlatinumBrush}" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Location Services:</Run>
                                    <Run Text=" Settings > Privacy &amp; security > Location > Turn ON"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Admin Permission -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.RequiresAdminElevation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="{ThemeResource StateHoldBrush}"/>
                                <TextBlock Foreground="{ThemeResource PlatinumBrush}" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Administrator:</Run>
                                    <Run Text=" Right-click app > Run as administrator"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="After enabling permissions, click SCAN again."
                                       Foreground="{ThemeResource SilverMuteBrush}" FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Networks List Section -->
                <StackPanel Spacing="8">
                    <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                        <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                        <TextBlock Text="AVAILABLE NETWORKS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>

                    <instruments:Plate Padding="0" MinHeight="350" VerticalContentAlignment="Stretch">
                        <Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.Networks, Mode=OneWay}"
                                      Background="Transparent" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="12"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WiFiNetworkDisplay">
                                        <Border Background="{ThemeResource Carbon800Brush}" CornerRadius="6" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Signal Icon -->
                                                <Border Style="{StaticResource IconContainerStyle}" Width="48" Height="48" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind SignalIcon}" instruments:StateBrush.Foreground="{x:Bind SignalState}" FontSize="20"/>
                                                </Border>

                                                <!-- Network Info -->
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Ssid}" Style="{StaticResource CardTitleStyle}"/>
                                                        <FontIcon Glyph="{x:Bind SecurityIcon}" instruments:StateBrush.Foreground="{x:Bind SecurityState}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Margin="0,2,0,0">
                                                        <Run Text="{x:Bind Security}"/> - <Run Text="{x:Bind Band}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{x:Bind Bssid}" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Channel -->
                                                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="60">
                                                    <TextBlock Text="Channel" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind Channel}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Frequency -->
                                                <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="80">
                                                    <TextBlock Text="Frequency" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind Frequency}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Signal Strength -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="60">
                                                    <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                                               instruments:StateBrush.Foreground="{x:Bind SignalState}">
                                                        <Run Text="{x:Bind SignalStrength}"/><Run Text="%" FontSize="12"/>
                                                    </TextBlock>
                                                    <ProgressBar Value="{x:Bind SignalStrength}" Maximum="100" Width="50" Height="4" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.NetworksFound, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE701;" FontSize="48" Foreground="{ThemeResource SilverMuteBrush}"/>
                                <TextBlock Text="No WiFi networks found" FontSize="14" Foreground="{ThemeResource SilverBrush}" Margin="0,12,0,0"/>
                                <TextBlock Text="Click 'SCAN' to search for available networks" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </instruments:Plate>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
