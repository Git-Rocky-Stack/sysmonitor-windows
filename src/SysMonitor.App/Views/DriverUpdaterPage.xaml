<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.DriverUpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysMonitor.App.Views"
    xmlns:vm="using:SysMonitor.App.ViewModels"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <instruments:ViewHeader Grid.Row="0" Module="DRIVERS" Index="16" Title="DRIVER UPDATER"
                                Description="Scan &amp; Manage System Drivers">
            <instruments:ViewHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ScanDriversCommand}"
                            Style="{StaticResource ChromeCapButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="SCAN"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.StopScanCommand}"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="STOP"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </instruments:ViewHeader.Actions>
        </instruments:ViewHeader>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,0,16">

                <!-- Stats Section -->
                <StackPanel Spacing="8">
                    <instruments:Faceplate Kicker="DRIVERS - DRIVER STATISTICS - 16A" Serial="{instruments:SerialFor Module=DRIVERS-DRIVER-STATISTICS}">
                        <StackPanel Spacing="8">

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Total" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalDrivers, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </instruments:Plate>

                                <instruments:Plate Grid.Column="1" Padding="16" VerticalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Up to Date" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.UpToDateDrivers, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateGoBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </instruments:Plate>

                                <instruments:Plate Grid.Column="2" Padding="16" VerticalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Outdated" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.OutdatedDrivers, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateHoldBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </instruments:Plate>

                                <instruments:Plate Grid.Column="3" Padding="16" VerticalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Problems" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.ProblemDriversCount, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateNoGoBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </instruments:Plate>

                                <instruments:Plate Grid.Column="4" Padding="16" VerticalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Unsigned" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.UnsignedDrivers, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource StateExecBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </instruments:Plate>
                            </Grid>
                        </StackPanel>
                    </instruments:Faceplate>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Spacing="8">
                    <instruments:Faceplate Kicker="DRIVERS - QUICK ACTIONS - 16B" Serial="{instruments:SerialFor Module=DRIVERS-QUICK-ACTIONS}">
                        <StackPanel Spacing="8">

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Command="{x:Bind ViewModel.OpenWindowsUpdateCommand}" Style="{StaticResource TileCapButtonStyle}">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE895;" FontSize="36"/>
                                        <TextBlock Text="WINDOWS UPDATE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Check for driver updates" FontSize="11" FontFamily="{StaticResource ConsoleBodyFontFamily}" Foreground="{ThemeResource SilverMuteBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenDeviceManagerCommand}" Style="{StaticResource TileCapButtonStyle}">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE964;" FontSize="36"/>
                                        <TextBlock Text="DEVICE MANAGER" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Manage device drivers" FontSize="11" FontFamily="{StaticResource ConsoleBodyFontFamily}" Foreground="{ThemeResource SilverMuteBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{x:Bind ViewModel.ExportReportCommand}" Style="{StaticResource TileCapButtonStyle}">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="36"/>
                                        <TextBlock Text="EXPORT REPORT" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Save driver inventory" FontSize="11" FontFamily="{StaticResource ConsoleBodyFontFamily}" Foreground="{ThemeResource SilverMuteBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </instruments:Faceplate>
                </StackPanel>

                <!-- Scan Status -->
                <instruments:BusyWell Title="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Problem Drivers Section (shown if problems exist) -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ProblemDriversCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <instruments:Faceplate Kicker="DRIVERS - ATTENTION REQUIRED - 16C" Serial="{instruments:SerialFor Module=DRIVERS-ATTENTION-REQUIRED}">
                        <StackPanel Spacing="8">

                            <instruments:Plate Padding="0" VerticalContentAlignment="Stretch">
                                <ListView ItemsSource="{x:Bind ViewModel.ProblemDrivers, Mode=OneWay}"
                                          Background="Transparent" SelectionMode="None" MaxHeight="250">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="8"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DriverDisplayItem">
                                            <instruments:Well Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Style="{StaticResource IconContainerStyle}" Width="40" Height="40" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind DeviceClassIcon}" FontSize="18" Foreground="{ThemeResource StateNoGoBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DeviceName}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind ProblemDescription}" FontSize="12" Foreground="{ThemeResource StateHoldBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <instruments:Chip State="{x:Bind StatusState}" Content="{x:Bind Status, Converter={StaticResource UpperCaseConverter}}" Grid.Column="2" VerticalAlignment="Center"/>
                                                </Grid>
                                            </instruments:Well>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </instruments:Plate>
                        </StackPanel>
                    </instruments:Faceplate>
                </StackPanel>

                <!-- All Drivers Section -->
                <instruments:Faceplate Kicker="DRIVERS - ALL DRIVERS - 16D" Serial="{instruments:SerialFor Module=DRIVERS-ALL-DRIVERS}">
                    <instruments:Faceplate.StripeRight>
                        <TextBlock Style="{StaticResource SerialTextStyle}">
                            <Run Text="LAST SCAN "/><Run Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}"/>
                        </TextBlock>
                    </instruments:Faceplate.StripeRight>
                    <StackPanel Spacing="8">

                        <instruments:Plate Padding="0" MinHeight="400" VerticalContentAlignment="Stretch">
                            <Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.Drivers, Mode=OneWay}"
                                          Background="Transparent" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="8"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DriverDisplayItem">
                                            <instruments:Well Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Style="{StaticResource IconContainerStyle}" Width="44" Height="44" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind DeviceClassIcon}" FontSize="20"
                                                                  instruments:StateBrush.Foreground="{x:Bind StatusState}"/>
                                                    </Border>

                                                    <!-- Device Info -->
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind DeviceName}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                            <!-- Badges -->
                                                            <Border Background="{ThemeResource RailNoGoBrush}" CornerRadius="3" Padding="6,2"
                                                                    Visibility="{x:Bind ProblemBadgeVisibility}">
                                                                <TextBlock Text="PROBLEM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ArmedFgBrush}"/>
                                                            </Border>
                                                            <Border Background="{ThemeResource RailHoldBrush}" CornerRadius="3" Padding="6,2"
                                                                    Visibility="{x:Bind OutdatedBadgeVisibility}">
                                                                <TextBlock Text="OUTDATED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ArmedFgBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource CardSubtitleStyle}" Margin="0,2,0,0">
                                                            <Run Text="{x:Bind Manufacturer}"/> • <Run Text="{x:Bind DeviceClass}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Version -->
                                                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center" MinWidth="100">
                                                        <TextBlock Text="Version" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}"/>
                                                        <TextBlock Text="{x:Bind DriverVersion}" FontSize="12" Foreground="{ThemeResource SilverBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                                    </StackPanel>

                                                    <!-- Date -->
                                                    <StackPanel Grid.Column="3" Margin="12,0" VerticalAlignment="Center" MinWidth="90">
                                                        <TextBlock Text="Driver Date" FontSize="11" Foreground="{ThemeResource SilverMuteBrush}"/>
                                                        <TextBlock Text="{x:Bind DriverDateText}" FontSize="12" Foreground="{ThemeResource SilverBrush}"/>
                                                    </StackPanel>

                                                    <!-- Signed Status -->
                                                    <instruments:Chip State="{x:Bind SignedState}" Content="{x:Bind SignedText, Converter={StaticResource UpperCaseConverter}}" Grid.Column="4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </instruments:Well>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE964;" FontSize="48" Foreground="{ThemeResource SilverMuteBrush}"/>
                                    <TextBlock Text="No drivers scanned yet" FontSize="14" Foreground="{ThemeResource SilverBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click 'SCAN' to analyze your system drivers" FontSize="12" Foreground="{ThemeResource SilverMuteBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </instruments:Plate>
                    </StackPanel>
                </instruments:Faceplate>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
