<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <instruments:ViewHeader Grid.Row="0" Module="BOOT" Index="08" Title="STARTUP MANAGER"
                                Description="Control Programs That Run at Boot"/>

        <!-- Action Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource IconContainerRedStyle}" Margin="0,0,16,0">
                    <FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="{ThemeResource PlatinumBrush}"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <!-- DISABLE -->
                    <Button Content="DISABLE" Command="{x:Bind ViewModel.DisableItemCommand}"/>
                    <!-- ENABLE -->
                    <Button Content="ENABLE" Command="{x:Bind ViewModel.EnableItemCommand}"/>
                    <!-- DELETE -->
                    <Button Content="DELETE" Command="{x:Bind ViewModel.DeleteItemCommand}"
                            Style="{StaticResource ArmedCapButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Startup Items List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.StartupItems, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,4,0,4"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="{ThemeResource Carbon750Brush}"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconContainerStyle}"
                                Width="40" Height="40" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE8FC;" FontSize="16" Foreground="{ThemeResource PlatinumBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{Binding Location}" Style="{StaticResource CardSubtitleStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Publisher}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SilverBrush}" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="3" Text="{Binding Impact}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource StateHoldBrush}"/>

                        <Border Grid.Column="4" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="{Binding IsEnabled, Converter={StaticResource BoolToSuccessBrushConverter}}">
                            <TextBlock Text="{Binding IsEnabled}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
