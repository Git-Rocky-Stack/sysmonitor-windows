<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SysMonitor.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments"
    Background="{ThemeResource Carbon950Brush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <instruments:ViewHeader Grid.Row="0" Module="PROC" Index="05" Title="PROCESS MANAGER"
                                Description="Real-time App Analytics"/>

        <!-- Process Controls Section -->
        <StackPanel Grid.Row="1" Spacing="12">
            <StackPanel Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="PROCESS CONTROLS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Toolbar -->
            <instruments:Plate Padding="16" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox PlaceholderText="Search processes..."
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="300" HorizontalAlignment="Left"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconContainerRedStyle}" Width="32" Height="32" Padding="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource PlatinumBrush}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SilverBrush}">
                                <Run Text="{x:Bind ViewModel.TotalProcesses, Mode=OneWay}" Foreground="{ThemeResource PlatinumBrush}" FontWeight="Bold"/>
                                <Run Text=" processes"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- END TASK -->
                        <Button Content="END TASK" Command="{x:Bind ViewModel.KillProcessCommand}"
                                Style="{StaticResource ArmedCapButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.SelectedProcess, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"/>
                    </StackPanel>
                </Grid>
            </instruments:Plate>
        </StackPanel>

        <!-- Running Processes Section -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Style="{StaticResource SectionHeaderWithAccentStyle}">
                <Border Style="{StaticResource AccentBarStyle}" Height="20"/>
                <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
            </StackPanel>

            <!-- Process List -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                  Background="Transparent">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="16,12" Background="{ThemeResource Carbon800Brush}"
                          BorderBrush="{ThemeResource PlateEdgeBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="CPU %" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Grid.Column="3" Text="PID" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource StatLabelStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16,12" BorderBrush="{ThemeResource PlateEdgeBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource PlatinumBrush}"/>
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource ArmedLitBrush}">
                            <Run Text="{Binding CpuUsagePercent, Converter={StaticResource PercentConverter}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Foreground="{ThemeResource SilverBrush}">
                            <Run Text="{Binding MemoryMB, Converter={StaticResource MBConverter}}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="{ThemeResource SilverBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{ThemeResource StateGoBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
