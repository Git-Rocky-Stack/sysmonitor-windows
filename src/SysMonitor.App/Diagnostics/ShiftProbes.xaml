<?xml version="1.0" encoding="utf-8"?>
<!-- For the UI smoke run's shift measurement only: theme dictionaries in a file merged straight into App.xaml,
     one level down, where the console's tokens are three. Removed with the fix the measurement decides. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ShiftProbeMergedBrush" Color="Black"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShiftProbeMergedBrush" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShiftProbeMergedBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
