<?xml version="1.0" encoding="utf-8"?>
<!--
    The Command Console's palette, transcribed from System-X (system-x-app@eaba14b, src/styles.css; the line
    numbers below are that file's).

    Every token is a Color and a Brush of the same name, in each of three themes:

      Default       Night Ops, the dark shift. Dark lookups fall back to it, and so does everything inside a Well
                    or Display, which set their own theme to Dark - that is how displays stay dark on Day Shift.
      Light         Day Shift, silver anodised: a designed second skin, not an inversion. Only the chassis
                    material changes; LEDs, displays, armed red and geometry are the same.
      HighContrast  the user's system colours. Surfaces take the window colour, text the window text colour,
                    anything lit or armed the highlight colour, and decoration goes.

    Colours are written here and nowhere else (ConsoleRecipeTests). Consumers ask with {ThemeResource}, so an
    element follows the theme it is shown in; inside a theme, a brush takes its colours from the same theme with
    {StaticResource}, and every theme defines the same keys (ThemeDictionaryParityTests). Code cannot follow a
    theme this way - Application.Current.Resources answers for the application's theme - so colours code needs
    live in one C# palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ============================================================ NIGHT OPS -->
        <ResourceDictionary x:Key="Default">
            <!-- Surfaces: the chassis, darkest first (:545-552, Day :726-732). -->
            <Color x:Key="VoidColor">#000000</Color>
            <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
            <Color x:Key="Carbon950Color">#050505</Color>
            <SolidColorBrush x:Key="Carbon950Brush" Color="{StaticResource Carbon950Color}"/>
            <Color x:Key="Carbon900Color">#0D0D0D</Color>
            <SolidColorBrush x:Key="Carbon900Brush" Color="{StaticResource Carbon900Color}"/>
            <Color x:Key="Carbon850Color">#101010</Color>
            <SolidColorBrush x:Key="Carbon850Brush" Color="{StaticResource Carbon850Color}"/>
            <Color x:Key="Carbon800Color">#141414</Color>
            <SolidColorBrush x:Key="Carbon800Brush" Color="{StaticResource Carbon800Color}"/>
            <Color x:Key="Carbon750Color">#1A1A1A</Color>
            <SolidColorBrush x:Key="Carbon750Brush" Color="{StaticResource Carbon750Color}"/>
            <Color x:Key="Carbon700Color">#262626</Color>
            <SolidColorBrush x:Key="Carbon700Brush" Color="{StaticResource Carbon700Color}"/>
            <Color x:Key="AnthraciteColor">#3A3A3A</Color>
            <SolidColorBrush x:Key="AnthraciteBrush" Color="{StaticResource AnthraciteColor}"/>

            <!-- Text, brightest first (:555-577, Day :734-738). SilverMute is set by the lightest ground it
                 prints on, the stripe grain; Graphite only ever paints a lamp that is not lit. -->
            <Color x:Key="PlatinumColor">#F5F5F5</Color>
            <SolidColorBrush x:Key="PlatinumBrush" Color="{StaticResource PlatinumColor}"/>
            <Color x:Key="SilverBrightColor">#D1D1D1</Color>
            <SolidColorBrush x:Key="SilverBrightBrush" Color="{StaticResource SilverBrightColor}"/>
            <Color x:Key="SilverColor">#B3B3B3</Color>
            <SolidColorBrush x:Key="SilverBrush" Color="{StaticResource SilverColor}"/>
            <Color x:Key="SilverMuteColor">#9C9C9C</Color>
            <SolidColorBrush x:Key="SilverMuteBrush" Color="{StaticResource SilverMuteColor}"/>
            <Color x:Key="GraphiteColor">#808080</Color>
            <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}"/>

            <!-- Armed red: LIVE, not error (:579-590, Day :766-770). Armed and ArmedDeep never change; ArmedLit
                 deepens on Day Shift for contrast on silver; ArmedDisplay is the bright form for armed text on
                 displays, which stay dark. -->
            <Color x:Key="ArmedColor">#AA2024</Color>
            <SolidColorBrush x:Key="ArmedBrush" Color="{StaticResource ArmedColor}"/>
            <Color x:Key="ArmedLitColor">#E8343A</Color>
            <SolidColorBrush x:Key="ArmedLitBrush" Color="{StaticResource ArmedLitColor}"/>
            <Color x:Key="ArmedDisplayColor">#E8343A</Color>
            <SolidColorBrush x:Key="ArmedDisplayBrush" Color="{StaticResource ArmedDisplayColor}"/>
            <Color x:Key="ArmedDeepColor">#7F171A</Color>
            <SolidColorBrush x:Key="ArmedDeepBrush" Color="{StaticResource ArmedDeepColor}"/>
            <Color x:Key="ArmedEdgeColor">#59E8343A</Color> <!-- rgba(232, 52, 58, .35) -->
            <SolidColorBrush x:Key="ArmedEdgeBrush" Color="{StaticResource ArmedEdgeColor}"/>
            <Color x:Key="ArmedGlowColor">#38E8343A</Color> <!-- rgba(232, 52, 58, .22) -->
            <SolidColorBrush x:Key="ArmedGlowBrush" Color="{StaticResource ArmedGlowColor}"/>
            <Color x:Key="ArmedSoftColor">#1FAA2024</Color> <!-- rgba(170, 32, 36, .12) -->
            <SolidColorBrush x:Key="ArmedSoftBrush" Color="{StaticResource ArmedSoftColor}"/>
            <Color x:Key="ArmedFgColor">#FFF3F0</Color>
            <SolidColorBrush x:Key="ArmedFgBrush" Color="{StaticResource ArmedFgColor}"/>

            <!-- Chrome: the polished bits, used sparingly (:592-595, Day :774). -->
            <Color x:Key="ChromeColor">#E6E6E6</Color>
            <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
            <Color x:Key="ChromeEdgeColor">#47E6E6E6</Color> <!-- rgba(230, 230, 230, .28) -->
            <SolidColorBrush x:Key="ChromeEdgeBrush" Color="{StaticResource ChromeEdgeColor}"/>
            <Color x:Key="ChromeSoftColor">#1AE6E6E6</Color> <!-- rgba(230, 230, 230, .1) -->
            <SolidColorBrush x:Key="ChromeSoftBrush" Color="{StaticResource ChromeSoftColor}"/>

            <!-- LEDs, the same in both shifts (:597-613). Each state is a word first; in High Contrast the word
                 is all of it. -->
            <Color x:Key="LedGoColor">#41E25E</Color>
            <SolidColorBrush x:Key="LedGoBrush" Color="{StaticResource LedGoColor}"/>
            <Color x:Key="LedHoldColor">#FFB000</Color>
            <SolidColorBrush x:Key="LedHoldBrush" Color="{StaticResource LedHoldColor}"/>
            <Color x:Key="LedWarnColor">#FF4438</Color>
            <SolidColorBrush x:Key="LedWarnBrush" Color="{StaticResource LedWarnColor}"/>
            <Color x:Key="LedNoGoColor">#C8453E</Color>
            <SolidColorBrush x:Key="LedNoGoBrush" Color="{StaticResource LedNoGoColor}"/>
            <Color x:Key="LedScopeColor">#58C4BC</Color>
            <SolidColorBrush x:Key="LedScopeBrush" Color="{StaticResource LedScopeColor}"/>
            <Color x:Key="LedOrangeColor">#FF7A1A</Color>
            <SolidColorBrush x:Key="LedOrangeBrush" Color="{StaticResource LedOrangeColor}"/>
            <Color x:Key="GoSoftColor">#1A41E25E</Color> <!-- rgba(65, 226, 94, .1) -->
            <SolidColorBrush x:Key="GoSoftBrush" Color="{StaticResource GoSoftColor}"/>
            <Color x:Key="HoldSoftColor">#1AFFB000</Color> <!-- rgba(255, 176, 0, .1) -->
            <SolidColorBrush x:Key="HoldSoftBrush" Color="{StaticResource HoldSoftColor}"/>
            <Color x:Key="WarnSoftColor">#1FFF4438</Color> <!-- rgba(255, 68, 56, .12) -->
            <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
            <Color x:Key="NoGoSoftColor">#1FC8453E</Color> <!-- rgba(200, 69, 62, .12) -->
            <SolidColorBrush x:Key="NoGoSoftBrush" Color="{StaticResource NoGoSoftColor}"/>
            <Color x:Key="ScopeSoftColor">#1A58C4BC</Color> <!-- rgba(88, 196, 188, .1) -->
            <SolidColorBrush x:Key="ScopeSoftBrush" Color="{StaticResource ScopeSoftColor}"/>
            <Color x:Key="GoEdgeColor">#5941E25E</Color> <!-- rgba(65, 226, 94, .35) -->
            <SolidColorBrush x:Key="GoEdgeBrush" Color="{StaticResource GoEdgeColor}"/>
            <Color x:Key="HoldEdgeColor">#59FFB000</Color> <!-- rgba(255, 176, 0, .35) -->
            <SolidColorBrush x:Key="HoldEdgeBrush" Color="{StaticResource HoldEdgeColor}"/>
            <Color x:Key="WarnEdgeColor">#66FF4438</Color> <!-- rgba(255, 68, 56, .4) -->
            <SolidColorBrush x:Key="WarnEdgeBrush" Color="{StaticResource WarnEdgeColor}"/>
            <Color x:Key="NoGoEdgeColor">#66C8453E</Color> <!-- rgba(200, 69, 62, .4) -->
            <SolidColorBrush x:Key="NoGoEdgeBrush" Color="{StaticResource NoGoEdgeColor}"/>
            <Color x:Key="ScopeEdgeColor">#5258C4BC</Color> <!-- rgba(88, 196, 188, .32) -->
            <SolidColorBrush x:Key="ScopeEdgeBrush" Color="{StaticResource ScopeEdgeColor}"/>

            <!-- State as text: the LED colour, safe to print on the chassis (:615-635, Day :740-764). Day Shift
                 darkens each along its own hue to clear 4.5:1 on Carbon950; warn and nogo share one red there,
                 which is why a warn rail blinks and the word is always printed. Inside a well or display the
                 Default values apply: the LEDs. -->
            <Color x:Key="StateGoColor">#41E25E</Color>
            <SolidColorBrush x:Key="StateGoBrush" Color="{StaticResource StateGoColor}"/>
            <Color x:Key="StateHoldColor">#FFB000</Color>
            <SolidColorBrush x:Key="StateHoldBrush" Color="{StaticResource StateHoldColor}"/>
            <Color x:Key="StateWarnColor">#FF4438</Color>
            <SolidColorBrush x:Key="StateWarnBrush" Color="{StaticResource StateWarnColor}"/>
            <Color x:Key="StateNoGoColor">#C8453E</Color>
            <SolidColorBrush x:Key="StateNoGoBrush" Color="{StaticResource StateNoGoColor}"/>
            <Color x:Key="StateExecColor">#58C4BC</Color>
            <SolidColorBrush x:Key="StateExecBrush" Color="{StaticResource StateExecColor}"/>

            <!-- Rails: the light pipe down a plate's mounting edge (:1149-1206), from the palette steps that
                 survive Day Shift (Night :261-309, Day :825-874). Wired to the LEDs, a rail would put #41E25E on
                 a near-white plate by day. -->
            <Color x:Key="RailGoColor">#41E25E</Color>
            <SolidColorBrush x:Key="RailGoBrush" Color="{StaticResource RailGoColor}"/>
            <Color x:Key="RailHoldColor">#FFB000</Color>
            <SolidColorBrush x:Key="RailHoldBrush" Color="{StaticResource RailHoldColor}"/>
            <Color x:Key="RailWarnColor">#FF4438</Color>
            <SolidColorBrush x:Key="RailWarnBrush" Color="{StaticResource RailWarnColor}"/>
            <Color x:Key="RailNoGoColor">#C8453E</Color>
            <SolidColorBrush x:Key="RailNoGoBrush" Color="{StaticResource RailNoGoColor}"/>
            <Color x:Key="RailExecColor">#58C4BC</Color>
            <SolidColorBrush x:Key="RailExecBrush" Color="{StaticResource RailExecColor}"/>

            <!-- Displays stay dark: defined once, the same in both shifts (:637-645). -->
            <Color x:Key="DisplayBgTopColor">#040404</Color>
            <SolidColorBrush x:Key="DisplayBgTopBrush" Color="{StaticResource DisplayBgTopColor}"/>
            <Color x:Key="DisplayBgBottomColor">#070707</Color>
            <SolidColorBrush x:Key="DisplayBgBottomBrush" Color="{StaticResource DisplayBgBottomColor}"/>
            <Color x:Key="DisplayBorderColor">#CC000000</Color> <!-- rgba(0, 0, 0, .8) -->
            <SolidColorBrush x:Key="DisplayBorderBrush" Color="{StaticResource DisplayBorderColor}"/>
            <Color x:Key="DisplayFgColor">#B3B3B3</Color>
            <SolidColorBrush x:Key="DisplayFgBrush" Color="{StaticResource DisplayFgColor}"/>
            <Color x:Key="DisplayFgMuteColor">#8A8A86</Color>
            <SolidColorBrush x:Key="DisplayFgMuteBrush" Color="{StaticResource DisplayFgMuteColor}"/>
            <Color x:Key="PhosphorColor">#41E25E</Color>
            <SolidColorBrush x:Key="PhosphorBrush" Color="{StaticResource PhosphorColor}"/>
            <Color x:Key="PhosphorDimColor">#2E5237</Color>
            <SolidColorBrush x:Key="PhosphorDimBrush" Color="{StaticResource PhosphorDimColor}"/>
            <Color x:Key="ScrimColor">#B8000000</Color> <!-- rgba(0, 0, 0, .72) -->
            <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}"/>

            <!-- Hairlines (:647-649, Day :772-773). -->
            <Color x:Key="HairlineColor">#14FFFFFF</Color> <!-- rgba(255, 255, 255, .08) -->
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
            <Color x:Key="HairlineStrongColor">#29FFFFFF</Color> <!-- rgba(255, 255, 255, .16) -->
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}"/>

            <!-- Faceplate and module plate: brushed aluminium, top to bottom, with its key light, edge, lip and
                 underside (:651-659, Day :777-784). -->
            <Color x:Key="Plate1Color">#1C1C1C</Color>
            <SolidColorBrush x:Key="Plate1Brush" Color="{StaticResource Plate1Color}"/>
            <Color x:Key="Plate2Color">#151515</Color>
            <SolidColorBrush x:Key="Plate2Brush" Color="{StaticResource Plate2Color}"/>
            <Color x:Key="Plate3Color">#101010</Color>
            <SolidColorBrush x:Key="Plate3Brush" Color="{StaticResource Plate3Color}"/>
            <Color x:Key="Plate4Color">#0C0C0C</Color>
            <SolidColorBrush x:Key="Plate4Brush" Color="{StaticResource Plate4Color}"/>
            <Color x:Key="PlateKeyColor">#0AFFFFFF</Color> <!-- rgba(255, 255, 255, .04) -->
            <SolidColorBrush x:Key="PlateKeyBrush" Color="{StaticResource PlateKeyColor}"/>
            <Color x:Key="PlateEdgeColor">#0FFFFFFF</Color> <!-- rgba(255, 255, 255, .06) -->
            <SolidColorBrush x:Key="PlateEdgeBrush" Color="{StaticResource PlateEdgeColor}"/>
            <Color x:Key="PlateLipColor">#1AFFFFFF</Color> <!-- rgba(255, 255, 255, .1) -->
            <SolidColorBrush x:Key="PlateLipBrush" Color="{StaticResource PlateLipColor}"/>
            <Color x:Key="PlateUnderColor">#B3000000</Color> <!-- rgba(0, 0, 0, .7) -->
            <SolidColorBrush x:Key="PlateUnderBrush" Color="{StaticResource PlateUnderColor}"/>

            <!-- Machined caps: buttons, chips, switches (:661-665, Day :786-790). -->
            <Color x:Key="Cap1Color">#1F1F1F</Color>
            <SolidColorBrush x:Key="Cap1Brush" Color="{StaticResource Cap1Color}"/>
            <Color x:Key="Cap2Color">#171717</Color>
            <SolidColorBrush x:Key="Cap2Brush" Color="{StaticResource Cap2Color}"/>
            <Color x:Key="Cap3Color">#121212</Color>
            <SolidColorBrush x:Key="Cap3Brush" Color="{StaticResource Cap3Color}"/>
            <Color x:Key="CapKeyColor">#0FFFFFFF</Color> <!-- rgba(255, 255, 255, .06) -->
            <SolidColorBrush x:Key="CapKeyBrush" Color="{StaticResource CapKeyColor}"/>
            <Color x:Key="CapEdgeColor">#0AFFFFFF</Color> <!-- rgba(255, 255, 255, .04) -->
            <SolidColorBrush x:Key="CapEdgeBrush" Color="{StaticResource CapEdgeColor}"/>

            <!-- Brushed stripe header, and its grain: directional machine brushing on a 3px period (:667-672, Day
                 :792-797). -->
            <Color x:Key="Stripe1Color">#2A2A2A</Color>
            <SolidColorBrush x:Key="Stripe1Brush" Color="{StaticResource Stripe1Color}"/>
            <Color x:Key="Stripe2Color">#1F1F1F</Color>
            <SolidColorBrush x:Key="Stripe2Brush" Color="{StaticResource Stripe2Color}"/>
            <Color x:Key="Stripe3Color">#181818</Color>
            <SolidColorBrush x:Key="Stripe3Brush" Color="{StaticResource Stripe3Color}"/>
            <Color x:Key="StripeGrainAColor">#09FFFFFF</Color> <!-- rgba(255, 255, 255, .035) -->
            <SolidColorBrush x:Key="StripeGrainABrush" Color="{StaticResource StripeGrainAColor}"/>
            <Color x:Key="StripeGrainBColor">#03FFFFFF</Color> <!-- rgba(255, 255, 255, .012) -->
            <SolidColorBrush x:Key="StripeGrainBBrush" Color="{StaticResource StripeGrainBColor}"/>
            <Color x:Key="StripeGrainCColor">#0F000000</Color> <!-- rgba(0, 0, 0, .06) -->
            <SolidColorBrush x:Key="StripeGrainCBrush" Color="{StaticResource StripeGrainCColor}"/>

            <!-- Edge light along a faceplate's top lip (:674-675, Day :799-800). -->
            <Color x:Key="EdgeLightColor">#2EE6E6E6</Color> <!-- rgba(230, 230, 230, .18) -->
            <SolidColorBrush x:Key="EdgeLightBrush" Color="{StaticResource EdgeLightColor}"/>
            <Color x:Key="EdgeLightMidColor">#52E6E6E6</Color> <!-- rgba(230, 230, 230, .32) -->
            <SolidColorBrush x:Key="EdgeLightMidBrush" Color="{StaticResource EdgeLightMidColor}"/>

            <!-- Hex socket-cap bolts, lit from the top left (:677-682, Day :802-807). Decoration: gone in High
                 Contrast. -->
            <Color x:Key="Hex1Color">#A4A4A4</Color>
            <SolidColorBrush x:Key="Hex1Brush" Color="{StaticResource Hex1Color}"/>
            <Color x:Key="Hex2Color">#7C7C7C</Color>
            <SolidColorBrush x:Key="Hex2Brush" Color="{StaticResource Hex2Color}"/>
            <Color x:Key="Hex3Color">#525252</Color>
            <SolidColorBrush x:Key="Hex3Brush" Color="{StaticResource Hex3Color}"/>
            <Color x:Key="Hex4Color">#323232</Color>
            <SolidColorBrush x:Key="Hex4Brush" Color="{StaticResource Hex4Color}"/>
            <Color x:Key="Hex5Color">#181818</Color>
            <SolidColorBrush x:Key="Hex5Brush" Color="{StaticResource Hex5Color}"/>
            <Color x:Key="Hex6Color">#0A0A0A</Color>
            <SolidColorBrush x:Key="Hex6Brush" Color="{StaticResource Hex6Color}"/>

            <!-- Selection, focus and the scrollbar thumb (:684-686, :710-712, Day :775, :809-810). -->
            <Color x:Key="SelectionBgColor">#59AA2024</Color> <!-- rgba(170, 32, 36, .35) -->
            <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}"/>
            <Color x:Key="FocusColor">#E6E6E6</Color>
            <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
            <Color x:Key="ScrollbarThumbColor">#94AA2024</Color> <!-- rgba(170, 32, 36, .58) -->
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}"/>
            <Color x:Key="ScrollbarThumbHoverColor">#D1E8343A</Color> <!-- rgba(232, 52, 58, .82) -->
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}"/>

            <!-- Chrome cap text: black on the polished face, platinum on Day Shift's black gloss (:2125, Day
                 :2135). -->
            <Color x:Key="ChromeCapForegroundColor">#0A0A0A</Color>
            <SolidColorBrush x:Key="ChromeCapForegroundBrush" Color="{StaticResource ChromeCapForegroundColor}"/>

            <!-- Faceplate (:1037): the face, top to bottom, and its key light from above left; the second key
                 light, over the top right corner's 140 x 60 (::after, :1098); the edge light along the top lip,
                 inset to clear the bolts (::before, :1078). -->
            <LinearGradientBrush x:Key="FaceplateFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Plate1Color}"/>
                <GradientStop Offset="0.35" Color="{StaticResource Plate2Color}"/>
                <GradientStop Offset="0.7" Color="{StaticResource Plate3Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Plate4Color}"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FaceplateKeyLightBrush" Center="0.3,-0.1" GradientOrigin="0.3,-0.1"
                                 RadiusX="0.8" RadiusY="0.6">
                <GradientStop Offset="0" Color="{StaticResource PlateKeyColor}"/>
                <GradientStop Offset="0.6" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FaceplateCornerLightBrush" Center="0.8,0" GradientOrigin="0.8,0"
                                 RadiusX="1.131" RadiusY="1.414">
                <GradientStop Offset="0" Color="{StaticResource PlateKeyColor}"/>
                <GradientStop Offset="0.7" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="FaceplateEdgeLightBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00E6E6E6"/>
                <GradientStop Offset="0.2" Color="{StaticResource EdgeLightColor}"/>
                <GradientStop Offset="0.5" Color="{StaticResource EdgeLightMidColor}"/>
                <GradientStop Offset="0.8" Color="{StaticResource EdgeLightColor}"/>
                <GradientStop Offset="1" Color="#00E6E6E6"/>
            </LinearGradientBrush>

            <!-- Module plate (:1136); armed, staged for a destructive run, lays ArmedSoft over the same face
                 (:1206), composited here because one brush cannot layer two. -->
            <LinearGradientBrush x:Key="PlateFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Plate1Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Plate3Color}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlateArmedFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2D1C1D"/>
                <GradientStop Offset="1" Color="#231212"/>
            </LinearGradientBrush>

            <!-- Cap: the face and its key light (:1467, and every button, :2062), and a chip's flatter face
                 (:2176). -->
            <LinearGradientBrush x:Key="CapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Cap1Color}"/>
                <GradientStop Offset="0.6" Color="{StaticResource Cap2Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Cap3Color}"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="CapKeyLightBrush" Center="0.5,0" GradientOrigin="0.5,0"
                                 RadiusX="0.8" RadiusY="0.5">
                <GradientStop Offset="0" Color="{StaticResource CapKeyColor}"/>
                <GradientStop Offset="0.6" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="ChipFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Cap1Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Cap3Color}"/>
            </LinearGradientBrush>

            <!-- Stripe header (:1503): the face, and the grain as hard 1px bands repeating every 3px. -->
            <LinearGradientBrush x:Key="StripeFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Stripe1Color}"/>
                <GradientStop Offset="0.55" Color="{StaticResource Stripe2Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Stripe3Color}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StripeGrainBrush" StartPoint="0,0" EndPoint="3,0"
                                 MappingMode="Absolute" SpreadMethod="Repeat">
                <GradientStop Offset="0" Color="{StaticResource StripeGrainAColor}"/>
                <GradientStop Offset="0.3333" Color="{StaticResource StripeGrainAColor}"/>
                <GradientStop Offset="0.3333" Color="{StaticResource StripeGrainBColor}"/>
                <GradientStop Offset="0.6667" Color="{StaticResource StripeGrainBColor}"/>
                <GradientStop Offset="0.6667" Color="{StaticResource StripeGrainCColor}"/>
                <GradientStop Offset="1" Color="{StaticResource StripeGrainCColor}"/>
            </LinearGradientBrush>

            <!-- Hex bolt (:1557): the head, lit from 28% 22% out to the farthest corner, and the socket, lit from
                 the opposite side (::after, :1589, Day :1602). -->
            <RadialGradientBrush x:Key="HexFaceBrush" Center="0.28,0.22" GradientOrigin="0.28,0.22"
                                 RadiusX="1.061" RadiusY="1.061">
                <GradientStop Offset="0" Color="{StaticResource Hex1Color}"/>
                <GradientStop Offset="0.12" Color="{StaticResource Hex2Color}"/>
                <GradientStop Offset="0.3" Color="{StaticResource Hex3Color}"/>
                <GradientStop Offset="0.55" Color="{StaticResource Hex4Color}"/>
                <GradientStop Offset="0.8" Color="{StaticResource Hex5Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Hex6Color}"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="HexSocketBrush" Center="0.72,0.78" GradientOrigin="0.72,0.78"
                                 RadiusX="1.061" RadiusY="1.061">
                <GradientStop Offset="0" Color="#242424"/>
                <GradientStop Offset="0.4" Color="#0E0E0E"/>
                <GradientStop Offset="1" Color="#000000"/>
            </RadialGradientBrush>

            <!-- Armed cap: consequential commands only, the same in both shifts (:2093). Chrome cap: the single
                 polished call to action, inverting to black gloss on Day Shift (:2116, Day :2131). -->
            <LinearGradientBrush x:Key="ArmedCapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#C8333A"/>
                <GradientStop Offset="0.55" Color="{StaticResource ArmedColor}"/>
                <GradientStop Offset="1" Color="{StaticResource ArmedDeepColor}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ChromeCapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FBFBFB"/>
                <GradientStop Offset="0.55" Color="#E6E6E6"/>
                <GradientStop Offset="1" Color="#C4C4C4"/>
            </LinearGradientBrush>

            <!-- Displays, wells and the annunciator strip: dark in both shifts (:1427, :1451, :1946). -->
            <LinearGradientBrush x:Key="DisplayFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource DisplayBgTopColor}"/>
                <GradientStop Offset="1" Color="{StaticResource DisplayBgBottomColor}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="WellFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#080808"/>
                <GradientStop Offset="1" Color="#0A0A0A"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AnnunciatorFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0E0E0E"/>
                <GradientStop Offset="1" Color="#090909"/>
            </LinearGradientBrush>

            <!-- Lamp caps, unlit and in each lit state, dark in both shifts (:1675, lit :1715-1779). -->
            <LinearGradientBrush x:Key="LampFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#131313"/>
                <GradientStop Offset="1" Color="#0A0A0A"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampGoFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0F1A12"/>
                <GradientStop Offset="1" Color="#070B08"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampHoldFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1A1508"/>
                <GradientStop Offset="1" Color="#0B0905"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampWarnFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1C0C0A"/>
                <GradientStop Offset="1" Color="#0C0605"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampNoGoFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1A0B0A"/>
                <GradientStop Offset="1" Color="#0B0605"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampExecFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#08191A"/>
                <GradientStop Offset="1" Color="#050B0B"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampArmedFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1C0A0B"/>
                <GradientStop Offset="1" Color="#0C0505"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ============================================================ DAY SHIFT -->
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces: the chassis, darkest first (:545-552, Day :726-732). -->
            <Color x:Key="VoidColor">#000000</Color>
            <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
            <Color x:Key="Carbon950Color">#C8C8C4</Color>
            <SolidColorBrush x:Key="Carbon950Brush" Color="{StaticResource Carbon950Color}"/>
            <Color x:Key="Carbon900Color">#D2D2CE</Color>
            <SolidColorBrush x:Key="Carbon900Brush" Color="{StaticResource Carbon900Color}"/>
            <Color x:Key="Carbon850Color">#CECEC9</Color>
            <SolidColorBrush x:Key="Carbon850Brush" Color="{StaticResource Carbon850Color}"/>
            <Color x:Key="Carbon800Color">#D8D8D4</Color>
            <SolidColorBrush x:Key="Carbon800Brush" Color="{StaticResource Carbon800Color}"/>
            <Color x:Key="Carbon750Color">#DEDEDA</Color>
            <SolidColorBrush x:Key="Carbon750Brush" Color="{StaticResource Carbon750Color}"/>
            <Color x:Key="Carbon700Color">#B0B0AC</Color>
            <SolidColorBrush x:Key="Carbon700Brush" Color="{StaticResource Carbon700Color}"/>
            <Color x:Key="AnthraciteColor">#96968F</Color>
            <SolidColorBrush x:Key="AnthraciteBrush" Color="{StaticResource AnthraciteColor}"/>

            <!-- Text, brightest first (:555-577, Day :734-738). SilverMute is set by the lightest ground it
                 prints on, the stripe grain; Graphite only ever paints a lamp that is not lit. -->
            <Color x:Key="PlatinumColor">#1A1A1A</Color>
            <SolidColorBrush x:Key="PlatinumBrush" Color="{StaticResource PlatinumColor}"/>
            <Color x:Key="SilverBrightColor">#2E2E2C</Color>
            <SolidColorBrush x:Key="SilverBrightBrush" Color="{StaticResource SilverBrightColor}"/>
            <Color x:Key="SilverColor">#44443F</Color>
            <SolidColorBrush x:Key="SilverBrush" Color="{StaticResource SilverColor}"/>
            <Color x:Key="SilverMuteColor">#4F4F4B</Color>
            <SolidColorBrush x:Key="SilverMuteBrush" Color="{StaticResource SilverMuteColor}"/>
            <Color x:Key="GraphiteColor">#96968F</Color>
            <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}"/>

            <!-- Armed red: LIVE, not error (:579-590, Day :766-770). Armed and ArmedDeep never change; ArmedLit
                 deepens on Day Shift for contrast on silver; ArmedDisplay is the bright form for armed text on
                 displays, which stay dark. -->
            <Color x:Key="ArmedColor">#AA2024</Color>
            <SolidColorBrush x:Key="ArmedBrush" Color="{StaticResource ArmedColor}"/>
            <Color x:Key="ArmedLitColor">#A31E23</Color>
            <SolidColorBrush x:Key="ArmedLitBrush" Color="{StaticResource ArmedLitColor}"/>
            <Color x:Key="ArmedDisplayColor">#E8343A</Color>
            <SolidColorBrush x:Key="ArmedDisplayBrush" Color="{StaticResource ArmedDisplayColor}"/>
            <Color x:Key="ArmedDeepColor">#7F171A</Color>
            <SolidColorBrush x:Key="ArmedDeepBrush" Color="{StaticResource ArmedDeepColor}"/>
            <Color x:Key="ArmedEdgeColor">#73A31E23</Color> <!-- rgba(163, 30, 35, .45) -->
            <SolidColorBrush x:Key="ArmedEdgeBrush" Color="{StaticResource ArmedEdgeColor}"/>
            <Color x:Key="ArmedGlowColor">#33A31E23</Color> <!-- rgba(163, 30, 35, .2) -->
            <SolidColorBrush x:Key="ArmedGlowBrush" Color="{StaticResource ArmedGlowColor}"/>
            <Color x:Key="ArmedSoftColor">#1FAA2024</Color> <!-- rgba(170, 32, 36, .12) -->
            <SolidColorBrush x:Key="ArmedSoftBrush" Color="{StaticResource ArmedSoftColor}"/>
            <Color x:Key="ArmedFgColor">#FFF3F0</Color>
            <SolidColorBrush x:Key="ArmedFgBrush" Color="{StaticResource ArmedFgColor}"/>

            <!-- Chrome: the polished bits, used sparingly (:592-595, Day :774). -->
            <Color x:Key="ChromeColor">#E6E6E6</Color>
            <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
            <Color x:Key="ChromeEdgeColor">#4D000000</Color> <!-- rgba(0, 0, 0, .3) -->
            <SolidColorBrush x:Key="ChromeEdgeBrush" Color="{StaticResource ChromeEdgeColor}"/>
            <Color x:Key="ChromeSoftColor">#1AE6E6E6</Color> <!-- rgba(230, 230, 230, .1) -->
            <SolidColorBrush x:Key="ChromeSoftBrush" Color="{StaticResource ChromeSoftColor}"/>

            <!-- LEDs, the same in both shifts (:597-613). Each state is a word first; in High Contrast the word
                 is all of it. -->
            <Color x:Key="LedGoColor">#41E25E</Color>
            <SolidColorBrush x:Key="LedGoBrush" Color="{StaticResource LedGoColor}"/>
            <Color x:Key="LedHoldColor">#FFB000</Color>
            <SolidColorBrush x:Key="LedHoldBrush" Color="{StaticResource LedHoldColor}"/>
            <Color x:Key="LedWarnColor">#FF4438</Color>
            <SolidColorBrush x:Key="LedWarnBrush" Color="{StaticResource LedWarnColor}"/>
            <Color x:Key="LedNoGoColor">#C8453E</Color>
            <SolidColorBrush x:Key="LedNoGoBrush" Color="{StaticResource LedNoGoColor}"/>
            <Color x:Key="LedScopeColor">#58C4BC</Color>
            <SolidColorBrush x:Key="LedScopeBrush" Color="{StaticResource LedScopeColor}"/>
            <Color x:Key="LedOrangeColor">#FF7A1A</Color>
            <SolidColorBrush x:Key="LedOrangeBrush" Color="{StaticResource LedOrangeColor}"/>
            <Color x:Key="GoSoftColor">#1A41E25E</Color> <!-- rgba(65, 226, 94, .1) -->
            <SolidColorBrush x:Key="GoSoftBrush" Color="{StaticResource GoSoftColor}"/>
            <Color x:Key="HoldSoftColor">#1AFFB000</Color> <!-- rgba(255, 176, 0, .1) -->
            <SolidColorBrush x:Key="HoldSoftBrush" Color="{StaticResource HoldSoftColor}"/>
            <Color x:Key="WarnSoftColor">#1FFF4438</Color> <!-- rgba(255, 68, 56, .12) -->
            <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
            <Color x:Key="NoGoSoftColor">#1FC8453E</Color> <!-- rgba(200, 69, 62, .12) -->
            <SolidColorBrush x:Key="NoGoSoftBrush" Color="{StaticResource NoGoSoftColor}"/>
            <Color x:Key="ScopeSoftColor">#1A58C4BC</Color> <!-- rgba(88, 196, 188, .1) -->
            <SolidColorBrush x:Key="ScopeSoftBrush" Color="{StaticResource ScopeSoftColor}"/>
            <Color x:Key="GoEdgeColor">#5941E25E</Color> <!-- rgba(65, 226, 94, .35) -->
            <SolidColorBrush x:Key="GoEdgeBrush" Color="{StaticResource GoEdgeColor}"/>
            <Color x:Key="HoldEdgeColor">#59FFB000</Color> <!-- rgba(255, 176, 0, .35) -->
            <SolidColorBrush x:Key="HoldEdgeBrush" Color="{StaticResource HoldEdgeColor}"/>
            <Color x:Key="WarnEdgeColor">#66FF4438</Color> <!-- rgba(255, 68, 56, .4) -->
            <SolidColorBrush x:Key="WarnEdgeBrush" Color="{StaticResource WarnEdgeColor}"/>
            <Color x:Key="NoGoEdgeColor">#66C8453E</Color> <!-- rgba(200, 69, 62, .4) -->
            <SolidColorBrush x:Key="NoGoEdgeBrush" Color="{StaticResource NoGoEdgeColor}"/>
            <Color x:Key="ScopeEdgeColor">#5258C4BC</Color> <!-- rgba(88, 196, 188, .32) -->
            <SolidColorBrush x:Key="ScopeEdgeBrush" Color="{StaticResource ScopeEdgeColor}"/>

            <!-- State as text: the LED colour, safe to print on the chassis (:615-635, Day :740-764). Day Shift
                 darkens each along its own hue to clear 4.5:1 on Carbon950; warn and nogo share one red there,
                 which is why a warn rail blinks and the word is always printed. Inside a well or display the
                 Default values apply: the LEDs. -->
            <Color x:Key="StateGoColor">#135724</Color>
            <SolidColorBrush x:Key="StateGoBrush" Color="{StaticResource StateGoColor}"/>
            <Color x:Key="StateHoldColor">#6F4700</Color>
            <SolidColorBrush x:Key="StateHoldBrush" Color="{StaticResource StateHoldColor}"/>
            <Color x:Key="StateWarnColor">#9E120A</Color>
            <SolidColorBrush x:Key="StateWarnBrush" Color="{StaticResource StateWarnColor}"/>
            <Color x:Key="StateNoGoColor">#9E120A</Color>
            <SolidColorBrush x:Key="StateNoGoBrush" Color="{StaticResource StateNoGoColor}"/>
            <Color x:Key="StateExecColor">#1D5854</Color>
            <SolidColorBrush x:Key="StateExecBrush" Color="{StaticResource StateExecColor}"/>

            <!-- Rails: the light pipe down a plate's mounting edge (:1149-1206), from the palette steps that
                 survive Day Shift (Night :261-309, Day :825-874). Wired to the LEDs, a rail would put #41E25E on
                 a near-white plate by day. -->
            <Color x:Key="RailGoColor">#0F5C2C</Color>
            <SolidColorBrush x:Key="RailGoBrush" Color="{StaticResource RailGoColor}"/>
            <Color x:Key="RailHoldColor">#6F4700</Color>
            <SolidColorBrush x:Key="RailHoldBrush" Color="{StaticResource RailHoldColor}"/>
            <Color x:Key="RailWarnColor">#A3140C</Color>
            <SolidColorBrush x:Key="RailWarnBrush" Color="{StaticResource RailWarnColor}"/>
            <Color x:Key="RailNoGoColor">#870F09</Color>
            <SolidColorBrush x:Key="RailNoGoBrush" Color="{StaticResource RailNoGoColor}"/>
            <Color x:Key="RailExecColor">#1A524E</Color>
            <SolidColorBrush x:Key="RailExecBrush" Color="{StaticResource RailExecColor}"/>

            <!-- Displays stay dark: defined once, the same in both shifts (:637-645). -->
            <Color x:Key="DisplayBgTopColor">#040404</Color>
            <SolidColorBrush x:Key="DisplayBgTopBrush" Color="{StaticResource DisplayBgTopColor}"/>
            <Color x:Key="DisplayBgBottomColor">#070707</Color>
            <SolidColorBrush x:Key="DisplayBgBottomBrush" Color="{StaticResource DisplayBgBottomColor}"/>
            <Color x:Key="DisplayBorderColor">#CC000000</Color> <!-- rgba(0, 0, 0, .8) -->
            <SolidColorBrush x:Key="DisplayBorderBrush" Color="{StaticResource DisplayBorderColor}"/>
            <Color x:Key="DisplayFgColor">#B3B3B3</Color>
            <SolidColorBrush x:Key="DisplayFgBrush" Color="{StaticResource DisplayFgColor}"/>
            <Color x:Key="DisplayFgMuteColor">#8A8A86</Color>
            <SolidColorBrush x:Key="DisplayFgMuteBrush" Color="{StaticResource DisplayFgMuteColor}"/>
            <Color x:Key="PhosphorColor">#41E25E</Color>
            <SolidColorBrush x:Key="PhosphorBrush" Color="{StaticResource PhosphorColor}"/>
            <Color x:Key="PhosphorDimColor">#2E5237</Color>
            <SolidColorBrush x:Key="PhosphorDimBrush" Color="{StaticResource PhosphorDimColor}"/>
            <Color x:Key="ScrimColor">#B8000000</Color> <!-- rgba(0, 0, 0, .72) -->
            <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}"/>

            <!-- Hairlines (:647-649, Day :772-773). -->
            <Color x:Key="HairlineColor">#1A000000</Color> <!-- rgba(0, 0, 0, .1) -->
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
            <Color x:Key="HairlineStrongColor">#33000000</Color> <!-- rgba(0, 0, 0, .2) -->
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}"/>

            <!-- Faceplate and module plate: brushed aluminium, top to bottom, with its key light, edge, lip and
                 underside (:651-659, Day :777-784). -->
            <Color x:Key="Plate1Color">#F5F5F3</Color>
            <SolidColorBrush x:Key="Plate1Brush" Color="{StaticResource Plate1Color}"/>
            <Color x:Key="Plate2Color">#EAEAE7</Color>
            <SolidColorBrush x:Key="Plate2Brush" Color="{StaticResource Plate2Color}"/>
            <Color x:Key="Plate3Color">#E0E0DC</Color>
            <SolidColorBrush x:Key="Plate3Brush" Color="{StaticResource Plate3Color}"/>
            <Color x:Key="Plate4Color">#D8D8D4</Color>
            <SolidColorBrush x:Key="Plate4Brush" Color="{StaticResource Plate4Color}"/>
            <Color x:Key="PlateKeyColor">#8CFFFFFF</Color> <!-- rgba(255, 255, 255, .55) -->
            <SolidColorBrush x:Key="PlateKeyBrush" Color="{StaticResource PlateKeyColor}"/>
            <Color x:Key="PlateEdgeColor">#1F000000</Color> <!-- rgba(0, 0, 0, .12) -->
            <SolidColorBrush x:Key="PlateEdgeBrush" Color="{StaticResource PlateEdgeColor}"/>
            <Color x:Key="PlateLipColor">#EBFFFFFF</Color> <!-- rgba(255, 255, 255, .92) -->
            <SolidColorBrush x:Key="PlateLipBrush" Color="{StaticResource PlateLipColor}"/>
            <Color x:Key="PlateUnderColor">#29000000</Color> <!-- rgba(0, 0, 0, .16) -->
            <SolidColorBrush x:Key="PlateUnderBrush" Color="{StaticResource PlateUnderColor}"/>

            <!-- Machined caps: buttons, chips, switches (:661-665, Day :786-790). -->
            <Color x:Key="Cap1Color">#F7F7F5</Color>
            <SolidColorBrush x:Key="Cap1Brush" Color="{StaticResource Cap1Color}"/>
            <Color x:Key="Cap2Color">#EBEBE8</Color>
            <SolidColorBrush x:Key="Cap2Brush" Color="{StaticResource Cap2Color}"/>
            <Color x:Key="Cap3Color">#DEDEDA</Color>
            <SolidColorBrush x:Key="Cap3Brush" Color="{StaticResource Cap3Color}"/>
            <Color x:Key="CapKeyColor">#BFFFFFFF</Color> <!-- rgba(255, 255, 255, .75) -->
            <SolidColorBrush x:Key="CapKeyBrush" Color="{StaticResource CapKeyColor}"/>
            <Color x:Key="CapEdgeColor">#1A000000</Color> <!-- rgba(0, 0, 0, .1) -->
            <SolidColorBrush x:Key="CapEdgeBrush" Color="{StaticResource CapEdgeColor}"/>

            <!-- Brushed stripe header, and its grain: directional machine brushing on a 3px period (:667-672, Day
                 :792-797). -->
            <Color x:Key="Stripe1Color">#F0F0ED</Color>
            <SolidColorBrush x:Key="Stripe1Brush" Color="{StaticResource Stripe1Color}"/>
            <Color x:Key="Stripe2Color">#E0E0DC</Color>
            <SolidColorBrush x:Key="Stripe2Brush" Color="{StaticResource Stripe2Color}"/>
            <Color x:Key="Stripe3Color">#D5D5D1</Color>
            <SolidColorBrush x:Key="Stripe3Brush" Color="{StaticResource Stripe3Color}"/>
            <Color x:Key="StripeGrainAColor">#09000000</Color> <!-- rgba(0, 0, 0, .035) -->
            <SolidColorBrush x:Key="StripeGrainABrush" Color="{StaticResource StripeGrainAColor}"/>
            <Color x:Key="StripeGrainBColor">#03000000</Color> <!-- rgba(0, 0, 0, .012) -->
            <SolidColorBrush x:Key="StripeGrainBBrush" Color="{StaticResource StripeGrainBColor}"/>
            <Color x:Key="StripeGrainCColor">#73FFFFFF</Color> <!-- rgba(255, 255, 255, .45) -->
            <SolidColorBrush x:Key="StripeGrainCBrush" Color="{StaticResource StripeGrainCColor}"/>

            <!-- Edge light along a faceplate's top lip (:674-675, Day :799-800). -->
            <Color x:Key="EdgeLightColor">#99FFFFFF</Color> <!-- rgba(255, 255, 255, .6) -->
            <SolidColorBrush x:Key="EdgeLightBrush" Color="{StaticResource EdgeLightColor}"/>
            <Color x:Key="EdgeLightMidColor">#F2FFFFFF</Color> <!-- rgba(255, 255, 255, .95) -->
            <SolidColorBrush x:Key="EdgeLightMidBrush" Color="{StaticResource EdgeLightMidColor}"/>

            <!-- Hex socket-cap bolts, lit from the top left (:677-682, Day :802-807). Decoration: gone in High
                 Contrast. -->
            <Color x:Key="Hex1Color">#FFFFFF</Color>
            <SolidColorBrush x:Key="Hex1Brush" Color="{StaticResource Hex1Color}"/>
            <Color x:Key="Hex2Color">#D8D8D4</Color>
            <SolidColorBrush x:Key="Hex2Brush" Color="{StaticResource Hex2Color}"/>
            <Color x:Key="Hex3Color">#AAAAA4</Color>
            <SolidColorBrush x:Key="Hex3Brush" Color="{StaticResource Hex3Color}"/>
            <Color x:Key="Hex4Color">#868680</Color>
            <SolidColorBrush x:Key="Hex4Brush" Color="{StaticResource Hex4Color}"/>
            <Color x:Key="Hex5Color">#5C5C58</Color>
            <SolidColorBrush x:Key="Hex5Brush" Color="{StaticResource Hex5Color}"/>
            <Color x:Key="Hex6Color">#44443F</Color>
            <SolidColorBrush x:Key="Hex6Brush" Color="{StaticResource Hex6Color}"/>

            <!-- Selection, focus and the scrollbar thumb (:684-686, :710-712, Day :775, :809-810). -->
            <Color x:Key="SelectionBgColor">#59AA2024</Color> <!-- rgba(170, 32, 36, .35) -->
            <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}"/>
            <Color x:Key="FocusColor">#2A2A2A</Color>
            <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
            <Color x:Key="ScrollbarThumbColor">#80AA2024</Color> <!-- rgba(170, 32, 36, .5) -->
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}"/>
            <Color x:Key="ScrollbarThumbHoverColor">#CCA31E23</Color> <!-- rgba(163, 30, 35, .8) -->
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}"/>

            <!-- Chrome cap text: black on the polished face, platinum on Day Shift's black gloss (:2125, Day
                 :2135). -->
            <Color x:Key="ChromeCapForegroundColor">#F5F5F5</Color>
            <SolidColorBrush x:Key="ChromeCapForegroundBrush" Color="{StaticResource ChromeCapForegroundColor}"/>

            <!-- Faceplate (:1037): the face, top to bottom, and its key light from above left; the second key
                 light, over the top right corner's 140 x 60 (::after, :1098); the edge light along the top lip,
                 inset to clear the bolts (::before, :1078). -->
            <LinearGradientBrush x:Key="FaceplateFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Plate1Color}"/>
                <GradientStop Offset="0.35" Color="{StaticResource Plate2Color}"/>
                <GradientStop Offset="0.7" Color="{StaticResource Plate3Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Plate4Color}"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FaceplateKeyLightBrush" Center="0.3,-0.1" GradientOrigin="0.3,-0.1"
                                 RadiusX="0.8" RadiusY="0.6">
                <GradientStop Offset="0" Color="{StaticResource PlateKeyColor}"/>
                <GradientStop Offset="0.6" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FaceplateCornerLightBrush" Center="0.8,0" GradientOrigin="0.8,0"
                                 RadiusX="1.131" RadiusY="1.414">
                <GradientStop Offset="0" Color="{StaticResource PlateKeyColor}"/>
                <GradientStop Offset="0.7" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="FaceplateEdgeLightBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00FFFFFF"/>
                <GradientStop Offset="0.2" Color="{StaticResource EdgeLightColor}"/>
                <GradientStop Offset="0.5" Color="{StaticResource EdgeLightMidColor}"/>
                <GradientStop Offset="0.8" Color="{StaticResource EdgeLightColor}"/>
                <GradientStop Offset="1" Color="#00FFFFFF"/>
            </LinearGradientBrush>

            <!-- Module plate (:1136); armed, staged for a destructive run, lays ArmedSoft over the same face
                 (:1206), composited here because one brush cannot layer two. -->
            <LinearGradientBrush x:Key="PlateFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Plate1Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Plate3Color}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlateArmedFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#ECDBDA"/>
                <GradientStop Offset="1" Color="#D9C9C6"/>
            </LinearGradientBrush>

            <!-- Cap: the face and its key light (:1467, and every button, :2062), and a chip's flatter face
                 (:2176). -->
            <LinearGradientBrush x:Key="CapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Cap1Color}"/>
                <GradientStop Offset="0.6" Color="{StaticResource Cap2Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Cap3Color}"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="CapKeyLightBrush" Center="0.5,0" GradientOrigin="0.5,0"
                                 RadiusX="0.8" RadiusY="0.5">
                <GradientStop Offset="0" Color="{StaticResource CapKeyColor}"/>
                <GradientStop Offset="0.6" Color="#00FFFFFF"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="ChipFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Cap1Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Cap3Color}"/>
            </LinearGradientBrush>

            <!-- Stripe header (:1503): the face, and the grain as hard 1px bands repeating every 3px. -->
            <LinearGradientBrush x:Key="StripeFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource Stripe1Color}"/>
                <GradientStop Offset="0.55" Color="{StaticResource Stripe2Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Stripe3Color}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StripeGrainBrush" StartPoint="0,0" EndPoint="3,0"
                                 MappingMode="Absolute" SpreadMethod="Repeat">
                <GradientStop Offset="0" Color="{StaticResource StripeGrainAColor}"/>
                <GradientStop Offset="0.3333" Color="{StaticResource StripeGrainAColor}"/>
                <GradientStop Offset="0.3333" Color="{StaticResource StripeGrainBColor}"/>
                <GradientStop Offset="0.6667" Color="{StaticResource StripeGrainBColor}"/>
                <GradientStop Offset="0.6667" Color="{StaticResource StripeGrainCColor}"/>
                <GradientStop Offset="1" Color="{StaticResource StripeGrainCColor}"/>
            </LinearGradientBrush>

            <!-- Hex bolt (:1557): the head, lit from 28% 22% out to the farthest corner, and the socket, lit from
                 the opposite side (::after, :1589, Day :1602). -->
            <RadialGradientBrush x:Key="HexFaceBrush" Center="0.28,0.22" GradientOrigin="0.28,0.22"
                                 RadiusX="1.061" RadiusY="1.061">
                <GradientStop Offset="0" Color="{StaticResource Hex1Color}"/>
                <GradientStop Offset="0.12" Color="{StaticResource Hex2Color}"/>
                <GradientStop Offset="0.3" Color="{StaticResource Hex3Color}"/>
                <GradientStop Offset="0.55" Color="{StaticResource Hex4Color}"/>
                <GradientStop Offset="0.8" Color="{StaticResource Hex5Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Hex6Color}"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="HexSocketBrush" Center="0.72,0.78" GradientOrigin="0.72,0.78"
                                 RadiusX="1.061" RadiusY="1.061">
                <GradientStop Offset="0" Color="#8A8A84"/>
                <GradientStop Offset="0.4" Color="#5C5C58"/>
                <GradientStop Offset="1" Color="#3A3A36"/>
            </RadialGradientBrush>

            <!-- Armed cap: consequential commands only, the same in both shifts (:2093). Chrome cap: the single
                 polished call to action, inverting to black gloss on Day Shift (:2116, Day :2131). -->
            <LinearGradientBrush x:Key="ArmedCapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#C8333A"/>
                <GradientStop Offset="0.55" Color="{StaticResource ArmedColor}"/>
                <GradientStop Offset="1" Color="{StaticResource ArmedDeepColor}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ChromeCapFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#303030"/>
                <GradientStop Offset="0.55" Color="#1A1A1A"/>
                <GradientStop Offset="1" Color="#0A0A0A"/>
            </LinearGradientBrush>

            <!-- Displays, wells and the annunciator strip: dark in both shifts (:1427, :1451, :1946). -->
            <LinearGradientBrush x:Key="DisplayFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{StaticResource DisplayBgTopColor}"/>
                <GradientStop Offset="1" Color="{StaticResource DisplayBgBottomColor}"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="WellFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#080808"/>
                <GradientStop Offset="1" Color="#0A0A0A"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AnnunciatorFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0E0E0E"/>
                <GradientStop Offset="1" Color="#090909"/>
            </LinearGradientBrush>

            <!-- Lamp caps, unlit and in each lit state, dark in both shifts (:1675, lit :1715-1779). -->
            <LinearGradientBrush x:Key="LampFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#131313"/>
                <GradientStop Offset="1" Color="#0A0A0A"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampGoFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0F1A12"/>
                <GradientStop Offset="1" Color="#070B08"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampHoldFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1A1508"/>
                <GradientStop Offset="1" Color="#0B0905"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampWarnFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1C0C0A"/>
                <GradientStop Offset="1" Color="#0C0605"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampNoGoFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1A0B0A"/>
                <GradientStop Offset="1" Color="#0B0605"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampExecFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#08191A"/>
                <GradientStop Offset="1" Color="#050B0B"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LampArmedFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1C0A0B"/>
                <GradientStop Offset="1" Color="#0C0505"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ============================================================ HIGH CONTRAST -->
        <ResourceDictionary x:Key="HighContrast">
            <!-- Surfaces: the chassis, darkest first (:545-552, Day :726-732). -->
            <StaticResource x:Key="VoidColor" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="VoidBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon950Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon950Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon900Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon900Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon850Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon850Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon800Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon800Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon750Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon750Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Carbon700Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Carbon700Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="AnthraciteColor" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="AnthraciteBrush" Color="{ThemeResource SystemColorWindowColor}"/>

            <!-- Text, brightest first (:555-577, Day :734-738). SilverMute is set by the lightest ground it
                 prints on, the stripe grain; Graphite only ever paints a lamp that is not lit. -->
            <StaticResource x:Key="PlatinumColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="PlatinumBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="SilverBrightColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="SilverBrightBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="SilverColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="SilverBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="SilverMuteColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="SilverMuteBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="GraphiteColor" ResourceKey="SystemColorGrayTextColor"/>
            <SolidColorBrush x:Key="GraphiteBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>

            <!-- Armed red: LIVE, not error (:579-590, Day :766-770). Armed and ArmedDeep never change; ArmedLit
                 deepens on Day Shift for contrast on silver; ArmedDisplay is the bright form for armed text on
                 displays, which stay dark. -->
            <StaticResource x:Key="ArmedColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ArmedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="ArmedLitColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ArmedLitBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="ArmedDisplayColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ArmedDisplayBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="ArmedDeepColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ArmedDeepBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="ArmedEdgeColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ArmedEdgeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <Color x:Key="ArmedGlowColor">Transparent</Color>
            <SolidColorBrush x:Key="ArmedGlowBrush" Color="Transparent"/>
            <Color x:Key="ArmedSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="ArmedSoftBrush" Color="Transparent"/>
            <StaticResource x:Key="ArmedFgColor" ResourceKey="SystemColorHighlightTextColor"/>
            <SolidColorBrush x:Key="ArmedFgBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>

            <!-- Chrome: the polished bits, used sparingly (:592-595, Day :774). -->
            <StaticResource x:Key="ChromeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="ChromeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="ChromeEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="ChromeEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <Color x:Key="ChromeSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="ChromeSoftBrush" Color="Transparent"/>

            <!-- LEDs, the same in both shifts (:597-613). Each state is a word first; in High Contrast the word
                 is all of it. -->
            <StaticResource x:Key="LedGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="LedHoldColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedHoldBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="LedWarnColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedWarnBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="LedNoGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedNoGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="LedScopeColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedScopeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="LedOrangeColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="LedOrangeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <Color x:Key="GoSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="GoSoftBrush" Color="Transparent"/>
            <Color x:Key="HoldSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="HoldSoftBrush" Color="Transparent"/>
            <Color x:Key="WarnSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="WarnSoftBrush" Color="Transparent"/>
            <Color x:Key="NoGoSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="NoGoSoftBrush" Color="Transparent"/>
            <Color x:Key="ScopeSoftColor">Transparent</Color>
            <SolidColorBrush x:Key="ScopeSoftBrush" Color="Transparent"/>
            <StaticResource x:Key="GoEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="GoEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="HoldEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="HoldEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="WarnEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="WarnEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="NoGoEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="NoGoEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="ScopeEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="ScopeEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>

            <!-- State as text: the LED colour, safe to print on the chassis (:615-635, Day :740-764). Day Shift
                 darkens each along its own hue to clear 4.5:1 on Carbon950; warn and nogo share one red there,
                 which is why a warn rail blinks and the word is always printed. Inside a well or display the
                 Default values apply: the LEDs. -->
            <StaticResource x:Key="StateGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="StateGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="StateHoldColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="StateHoldBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="StateWarnColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="StateWarnBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="StateNoGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="StateNoGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="StateExecColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="StateExecBrush" Color="{ThemeResource SystemColorHighlightColor}"/>

            <!-- Rails: the light pipe down a plate's mounting edge (:1149-1206), from the palette steps that
                 survive Day Shift (Night :261-309, Day :825-874). Wired to the LEDs, a rail would put #41E25E on
                 a near-white plate by day. -->
            <StaticResource x:Key="RailGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="RailGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="RailHoldColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="RailHoldBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="RailWarnColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="RailWarnBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="RailNoGoColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="RailNoGoBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="RailExecColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="RailExecBrush" Color="{ThemeResource SystemColorHighlightColor}"/>

            <!-- Displays stay dark: defined once, the same in both shifts (:637-645). -->
            <StaticResource x:Key="DisplayBgTopColor" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="DisplayBgTopBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="DisplayBgBottomColor" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="DisplayBgBottomBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="DisplayBorderColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="DisplayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="DisplayFgColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="DisplayFgBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="DisplayFgMuteColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="DisplayFgMuteBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="PhosphorColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="PhosphorBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="PhosphorDimColor" ResourceKey="SystemColorGrayTextColor"/>
            <SolidColorBrush x:Key="PhosphorDimBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <StaticResource x:Key="ScrimColor" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.72"/>

            <!-- Hairlines (:647-649, Day :772-773). -->
            <StaticResource x:Key="HairlineColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="HairlineStrongColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>

            <!-- Faceplate and module plate: brushed aluminium, top to bottom, with its key light, edge, lip and
                 underside (:651-659, Day :777-784). -->
            <StaticResource x:Key="Plate1Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Plate1Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Plate2Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Plate2Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Plate3Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Plate3Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Plate4Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Plate4Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <Color x:Key="PlateKeyColor">Transparent</Color>
            <SolidColorBrush x:Key="PlateKeyBrush" Color="Transparent"/>
            <StaticResource x:Key="PlateEdgeColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="PlateEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <Color x:Key="PlateLipColor">Transparent</Color>
            <SolidColorBrush x:Key="PlateLipBrush" Color="Transparent"/>
            <Color x:Key="PlateUnderColor">Transparent</Color>
            <SolidColorBrush x:Key="PlateUnderBrush" Color="Transparent"/>

            <!-- Machined caps: buttons, chips, switches (:661-665, Day :786-790). -->
            <StaticResource x:Key="Cap1Color" ResourceKey="SystemColorButtonFaceColor"/>
            <SolidColorBrush x:Key="Cap1Brush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <StaticResource x:Key="Cap2Color" ResourceKey="SystemColorButtonFaceColor"/>
            <SolidColorBrush x:Key="Cap2Brush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <StaticResource x:Key="Cap3Color" ResourceKey="SystemColorButtonFaceColor"/>
            <SolidColorBrush x:Key="Cap3Brush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <Color x:Key="CapKeyColor">Transparent</Color>
            <SolidColorBrush x:Key="CapKeyBrush" Color="Transparent"/>
            <StaticResource x:Key="CapEdgeColor" ResourceKey="SystemColorButtonTextColor"/>
            <SolidColorBrush x:Key="CapEdgeBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>

            <!-- Brushed stripe header, and its grain: directional machine brushing on a 3px period (:667-672, Day
                 :792-797). -->
            <StaticResource x:Key="Stripe1Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Stripe1Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Stripe2Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Stripe2Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <StaticResource x:Key="Stripe3Color" ResourceKey="SystemColorWindowColor"/>
            <SolidColorBrush x:Key="Stripe3Brush" Color="{ThemeResource SystemColorWindowColor}"/>
            <Color x:Key="StripeGrainAColor">Transparent</Color>
            <SolidColorBrush x:Key="StripeGrainABrush" Color="Transparent"/>
            <Color x:Key="StripeGrainBColor">Transparent</Color>
            <SolidColorBrush x:Key="StripeGrainBBrush" Color="Transparent"/>
            <Color x:Key="StripeGrainCColor">Transparent</Color>
            <SolidColorBrush x:Key="StripeGrainCBrush" Color="Transparent"/>

            <!-- Edge light along a faceplate's top lip (:674-675, Day :799-800). -->
            <Color x:Key="EdgeLightColor">Transparent</Color>
            <SolidColorBrush x:Key="EdgeLightBrush" Color="Transparent"/>
            <Color x:Key="EdgeLightMidColor">Transparent</Color>
            <SolidColorBrush x:Key="EdgeLightMidBrush" Color="Transparent"/>

            <!-- Hex socket-cap bolts, lit from the top left (:677-682, Day :802-807). Decoration: gone in High
                 Contrast. -->
            <Color x:Key="Hex1Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex1Brush" Color="Transparent"/>
            <Color x:Key="Hex2Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex2Brush" Color="Transparent"/>
            <Color x:Key="Hex3Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex3Brush" Color="Transparent"/>
            <Color x:Key="Hex4Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex4Brush" Color="Transparent"/>
            <Color x:Key="Hex5Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex5Brush" Color="Transparent"/>
            <Color x:Key="Hex6Color">Transparent</Color>
            <SolidColorBrush x:Key="Hex6Brush" Color="Transparent"/>

            <!-- Selection, focus and the scrollbar thumb (:684-686, :710-712, Day :775, :809-810). -->
            <StaticResource x:Key="SelectionBgColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="SelectionBgBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="FocusColor" ResourceKey="SystemColorWindowTextColor"/>
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <StaticResource x:Key="ScrollbarThumbColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <StaticResource x:Key="ScrollbarThumbHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>

            <!-- Chrome cap text: black on the polished face, platinum on Day Shift's black gloss (:2125, Day
                 :2135). -->
            <StaticResource x:Key="ChromeCapForegroundColor" ResourceKey="SystemColorButtonTextColor"/>
            <SolidColorBrush x:Key="ChromeCapForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>

            <!-- Composed faces become solid system colours, and decoration - key lights, grain, edge light, bolts
                 - goes. -->
            <SolidColorBrush x:Key="FaceplateFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="FaceplateKeyLightBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="FaceplateCornerLightBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="FaceplateEdgeLightBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="PlateFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PlateArmedFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CapFaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="CapKeyLightBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ChipFaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="StripeFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StripeGrainBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="HexFaceBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="HexSocketBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ArmedCapFaceBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ChromeCapFaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="DisplayFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="WellFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="AnnunciatorFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampGoFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampHoldFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampWarnFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampNoGoFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampExecFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LampArmedFaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Machined radii, the same in every shift (:697-702). -->
    <CornerRadius x:Key="PlateCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="InsetCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">9999</CornerRadius>

    <!-- Spacing, base 4 and Fibonacci-flavoured (:688-695). -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">20</x:Double>
    <x:Double x:Key="Space5">32</x:Double>
    <x:Double x:Key="Space6">52</x:Double>
    <x:Double x:Key="Space7">84</x:Double>

    <!-- A faceplate's body clears the corner bolts: 24 at the sides, deeper at the foot (:1117). Its stripe header
         is 36 high, padded 30 to clear the bolts (:1503). -->
    <Thickness x:Key="FaceplateBodyPadding">24,16,24,24</Thickness>
    <x:Double x:Key="StripeHeight">36</x:Double>
    <Thickness x:Key="StripePadding">30,0,30,0</Thickness>
</ResourceDictionary>
