<?xml version="1.0" encoding="utf-8"?>
<!--
    The Command Console's text styles, as System-X sets them (system-x-app@eaba14b: DESIGN.md section 5 and
    src/styles.css; the line numbers below are that file's).

    Four faces, four jobs. Archivo caps are reserved for the view title, placards and lamp codes, so the
    interface states rather than shouts; headings are Public Sans 600, and so is nothing louder. A number that
    updates live wears Departure Mono, prose wears Public Sans, and code and paths wear Iosevka.

    Letter spacing is CharacterSpacing, in thousandths of an em (.08em is 80). Line heights are exact, as a
    browser's are, so LineStackingStrategy is BlockLineHeight wherever one is set. Upper case is written in the
    text or applied by the control that shows it, never by these styles, because the source strings are what
    the documentation and the claim tests quote. WinUI's own text styles (BodyTextBlockStyle and the rest) are
    left as they are: the framework's templates look them up by name.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ STENCILS: Archivo, tracked caps -->

    <!-- The view title (:1659): Archivo 800 at width 118, 21 over 1.2, tracked .05em. -->
    <Style x:Key="ViewTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTitleFontFamily}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="CharacterSpacing" Value="50"/>
        <Setter Property="LineHeight" Value="25.2"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <!-- A placard (:1631): Archivo 700 at width 118, 10.5 on a line of its own height, tracked .08em. -->
    <Style x:Key="PlacardTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsolePlacardFontFamily}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="LineHeight" Value="10.5"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource SilverMuteBrush}"/>
    </Style>

    <!-- ============================================================ SILKSCREEN: Departure Mono -->

    <!-- A faceplate's kicker (:1642): Departure Mono 11, tracked .08em. -->
    <Style x:Key="KickerTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Foreground" Value="{ThemeResource SilverBrush}"/>
    </Style>

    <!-- A serial (:1651): Departure Mono 10, tracked .06em. -->
    <Style x:Key="SerialTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="60"/>
        <Setter Property="Foreground" Value="{ThemeResource SilverMuteBrush}"/>
    </Style>

    <!-- A form field's label (:2312): Departure Mono 10, tracked .12em, 5 above its field. -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="120"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Foreground" Value="{ThemeResource SilverMuteBrush}"/>
    </Style>

    <!-- ============================================================ PROSE: Public Sans -->

    <!-- Body copy (:911-918): Public Sans 14 over 1.55. -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodyFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="21.7"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <!-- A description under a title or a control: Public Sans 13 over 1.55, a step down the text ramp. -->
    <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20.15"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{ThemeResource SilverBrush}"/>
    </Style>

    <!-- Headings (:926-935): Public Sans 600 over 1.2, never Archivo caps. The size marks the level: 15, 14 and
         13, the steps System-X's pages use. -->
    <Style x:Key="Heading2TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodySemiBoldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <Style x:Key="Heading3TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodySemiBoldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="16.8"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <Style x:Key="Heading4TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodySemiBoldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="15.6"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <!-- ============================================================ TELEMETRY: Departure Mono, live numbers -->

    <!-- Any number that updates live (:2569), at whatever size its place needs. The face is monospaced, so the
         figures line up as tabular figures do. -->
    <Style x:Key="TelemetryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
    </Style>

    <!-- The big readout, such as the Dashboard's health score: Departure Mono 44 on a line of its own height.
         Its colour is its state's, so the style leaves it to the element. -->
    <Style x:Key="ReadoutTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="44"/>
        <Setter Property="LineHeight" Value="44"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- An LCD's label and value (:1865-1880), on the display colours, which are the same in both shifts. -->
    <Style x:Key="LcdLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="CharacterSpacing" Value="120"/>
        <Setter Property="LineHeight" Value="9"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource DisplayFgMuteBrush}"/>
    </Style>

    <Style x:Key="LcdValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleTelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="LineHeight" Value="19.8"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource PhosphorBrush}"/>
    </Style>

    <!-- ============================================================ STREAMS: Iosevka -->

    <!-- A log, a path, a command line (:1964): Iosevka 11 over 1.5, on the display colours. -->
    <Style x:Key="StreamTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleCodeFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="16.5"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource DisplayFgBrush}"/>
    </Style>
</ResourceDictionary>
