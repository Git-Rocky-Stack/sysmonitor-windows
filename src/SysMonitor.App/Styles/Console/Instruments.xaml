        <Setter Property="SegmentGoBrush" Value="{ThemeResource LedGoBrush}"/>
        <Setter Property="SegmentHoldBrush" Value="{ThemeResource LedHoldBrush}"/>
        <Setter Property="SegmentOrangeBrush" Value="{ThemeResource LedOrangeBrush}"/>
