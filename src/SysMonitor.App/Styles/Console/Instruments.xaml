<?xml version="1.0" encoding="utf-8"?>
<!--
    The console's instruments, as System-X draws them (system-x-app@eaba14b: src/components/console and
    src/styles.css; the line numbers below are that file's). Each instrument's look is an implicit style here;
    what it does is its class in Controls/Instruments.

    CSS gives one box its shadows, lips and lights at once. WinUI draws each as an element of its own, so a
    template stacks them in the order a browser paints them: the face, its key light, the inset edges, the
    content, then the lights and bolts that sit over it. An inset shadow, which WinUI does not have, is a
    gradient over the edge it falls from. Every colour is a token asked for with ThemeResource, so each
    instrument follows the shift it is shown in, and the decoration goes in High Contrast, where those tokens
    are transparent.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:instruments="using:SysMonitor.App.Controls.Instruments">

    <!-- The palette and the text styles come from Tokens.xaml and Typography.xaml, which App.xaml merges ahead of
         this file, and only App.xaml merges the palette (ConsoleDictionaryTests). -->

    <!-- ============================================================ HEX BOLT (:1557-1622) -->

    <!-- A flat-topped hexagon, as System-X clips it: 25% and 75% along the top and bottom, the middle of each
         side. The drop shadow is two copies 1 and 2 below; the socket is the same hexagon, 30% in. -->
    <Style TargetType="instruments:HexBolt">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:HexBolt">
                    <Grid>
                        <Path Data="M4,2 L12,2 L16,10 L12,18 L4,18 L0,10 Z" Fill="{ThemeResource HexShadowFarBrush}"/>
                        <Path Data="M4,1 L12,1 L16,9 L12,17 L4,17 L0,9 Z" Fill="{ThemeResource HexShadowNearBrush}"/>
                        <Path Data="M4,0 L12,0 L16,8 L12,16 L4,16 L0,8 Z" Fill="{ThemeResource HexFaceBrush}"/>
                        <Path Data="M4,0 L12,0 L16,8 L12,16 L4,16 L0,8 Z" Fill="{ThemeResource HexRingBrush}"/>
                        <Path Data="M6.4,4.8 L9.6,4.8 L11.2,8 L9.6,11.2 L6.4,11.2 L4.8,8 Z"
                              Fill="{ThemeResource HexSocketBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ FACEPLATE (:1037-1119, stripe :1503-1555) -->

    <Style TargetType="instruments:Faceplate">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="{StaticResource FaceplateBodyPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
        <Setter Property="EdgeShadowColor" Value="{ThemeResource FaceplateShadowEdgeColor}"/>
        <Setter Property="ContactShadowColor" Value="{ThemeResource FaceplateShadowContactColor}"/>
        <Setter Property="DropShadowColor" Value="{ThemeResource FaceplateShadowDropColor}"/>
        <Setter Property="AmbientShadowColor" Value="{ThemeResource FaceplateShadowAmbientColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:Faceplate">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StripeStates">
                                <VisualState x:Name="Striped"/>
                                <VisualState x:Name="Bare">
                                    <VisualState.Setters>
                                        <Setter Target="Stripe.Visibility" Value="Collapsed"/>
                                        <Setter Target="StripeSeamLight.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="BoltStates">
                                <VisualState x:Name="Bolted"/>
                                <VisualState x:Name="Unbolted">
                                    <VisualState.Setters>
                                        <Setter Target="Bolts.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- The shadows it casts on the chassis, drawn by composition behind the face (Faceplate.cs). -->
                        <Border x:Name="PART_ShadowHost" IsHitTestVisible="False"/>

                        <Border Background="{ThemeResource FaceplateFaceBrush}"
                                BorderBrush="{ThemeResource PlateEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PlateCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- The key light from above left, then the inset edges: the lip along the top, the
                                     underside along the bottom, light down the left and shade down the right. -->
                                <Border Grid.RowSpan="2" Background="{ThemeResource FaceplateKeyLightBrush}"/>
                                <Border Grid.RowSpan="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PlateLipBrush}"/>
                                <Border Grid.RowSpan="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PlateUnderBrush}"/>
                                <Border Grid.RowSpan="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource FaceplateSideLightBrush}"/>
                                <Border Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource FaceplateSideShadeBrush}"/>

                                <ContentPresenter Grid.Row="1"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                <!-- The second key light, over the top right corner. -->
                                <Border Grid.RowSpan="2" Width="140" Height="60"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="{StaticResource PlateCornerRadius}"
                                        Background="{ThemeResource FaceplateCornerLightBrush}"
                                        IsHitTestVisible="False"/>

                                <!-- The brushed stripe: the face, its grain, the lip along its top and the seam below
                                     it; the kicker and serial, and the right-hand slot. Padded 30 to clear the bolts. -->
                                <Grid x:Name="Stripe" Height="{StaticResource StripeHeight}">
                                    <Border Background="{ThemeResource StripeFaceBrush}" CornerRadius="1,1,0,0"/>
                                    <Border Background="{ThemeResource StripeGrainBrush}" CornerRadius="1,1,0,0"/>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PlateLipBrush}" CornerRadius="1,1,0,0"/>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource StripeSeamBrush}"/>
                                    <Grid Padding="{StaticResource StripePadding}" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource KickerTextStyle}" VerticalAlignment="Center"
                                                   Text="{TemplateBinding Kicker}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource SerialTextStyle}" VerticalAlignment="Center"
                                                   Text="{TemplateBinding Serial}"/>
                                        <!-- A ContentControl, not a ContentPresenter. WinUI binds a presenter in a
                                             ContentControl's template to the control's own Content while its Content
                                             is unset, and a TemplateBinding to a property the app registers does not
                                             count as set. An empty slot then took the faceplate's body as well, and a
                                             body that is an element, given a second parent, ended the process from
                                             inside layout. -->
                                        <ContentControl Grid.Column="3" VerticalAlignment="Center" IsTabStop="False"
                                                        Content="{TemplateBinding StripeRight}"/>
                                    </Grid>
                                </Grid>
                                <Border x:Name="StripeSeamLight" Grid.Row="1" Height="1" VerticalAlignment="Top"
                                        Background="{ThemeResource StripeSeamLightBrush}" IsHitTestVisible="False"/>

                                <!-- The edge light along the top lip, inset to clear the bolts. -->
                                <Border Grid.RowSpan="2" Height="1" Margin="24,2,24,0" VerticalAlignment="Top"
                                        Background="{ThemeResource FaceplateEdgeLightBrush}" IsHitTestVisible="False"/>

                                <Grid x:Name="Bolts" Grid.RowSpan="2">
                                    <instruments:HexBolt Margin="7,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <instruments:HexBolt Margin="0,10,7,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <instruments:HexBolt Margin="7,0,0,7" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <instruments:HexBolt Margin="0,0,7,7" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ WELL (:1451-1462) -->

    <!-- The recess: a void-black face in a black edge, shaded in from the top and both sides, with a glint along
         the lower lip. The well sets its own theme to Dark (Well.cs), so its content wears Night Ops colours in
         both shifts. -->
    <Style TargetType="instruments:Well">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{ThemeResource DisplayFgBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:Well">
                    <Border Background="{ThemeResource WellFaceBrush}"
                            BorderBrush="{ThemeResource WellEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PlateCornerRadius}">
                        <Grid>
                            <Border Height="6" VerticalAlignment="Top" Background="{ThemeResource WellShadeTopBrush}"/>
                            <Border Width="3" HorizontalAlignment="Left" Background="{ThemeResource WellShadeLeftBrush}"/>
                            <Border Width="3" HorizontalAlignment="Right" Background="{ThemeResource WellShadeRightBrush}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource WellLipBrush}"/>
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ DISPLAY (:1427-1449) -->

    <!-- The display gradient, always painted, with a result's tint laid over it rather than in place of it. -->
    <Style TargetType="instruments:Display">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{ThemeResource DisplayFgBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:Display">
                    <Grid Background="{ThemeResource DisplayFaceBrush}" CornerRadius="{StaticResource PlateCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ToneStates">
                                <VisualState x:Name="None"/>
                                <VisualState x:Name="Go">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource GoSoftBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NoGo">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource NoGoSoftBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Tint" CornerRadius="{StaticResource PlateCornerRadius}"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ LAMP (:1675-1789) -->

    <!-- A dark cap lit in its state's colour: the face and its edge, an inner ring of the state's soft light, the
         light along the top and the shade along the bottom, and the stencil word in Archivo at width 110, tracked
         .1em. It sits on a small shadow, and lit it glows outside in its soft colour and round its word in its
         LED's (:1697-1789). Warn blinks the whole lamp at 1 Hz, down to 18% (:458-467); WarnSteady is the same
         lamp held lit, for when animation effects are off. Striking brings it up from 35% in 80 ms, once. -->
    <Style TargetType="instruments:Lamp">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ShadowColor" Value="{ThemeResource LampShadowColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:Lamp">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LampStates">
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="Go">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource GoSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampGoFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource GoEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource GoSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedGoBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Hold">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource HoldSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampHoldFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource HoldEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource HoldSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedHoldBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Warn">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource WarnSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampWarnFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource WarnEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource WarnSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedWarnBrush}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cap" Storyboard.TargetProperty="Opacity"
                                                                       Duration="0:0:1" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.18"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="WarnSteady">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource WarnSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampWarnFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource WarnEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource WarnSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedWarnBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NoGo">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource NoGoSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampNoGoFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NoGoEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource NoGoSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedNoGoBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Exec">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource ScopeSoftBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampExecFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource ScopeEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource ScopeSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource LedScopeBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Armed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OuterGlow.Background" Value="{ThemeResource ArmedGlowBrush}"/>
                                        <Setter Target="Face.Background" Value="{ThemeResource LampArmedFaceBrush}"/>
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource ArmedEdgeBrush}"/>
                                        <Setter Target="Glow.BorderBrush" Value="{ThemeResource ArmedSoftBrush}"/>
                                        <Setter Target="Word.Foreground" Value="{ThemeResource ArmedDisplayBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Medium"/>
                                <VisualState x:Name="Small">
                                    <VisualState.Setters>
                                        <Setter Target="Cap.Height" Value="19"/>
                                        <Setter Target="Cap.MinWidth" Value="36"/>
                                        <Setter Target="Word.Margin" Value="7,0"/>
                                        <Setter Target="Word.FontSize" Value="9"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="StrikeStates">
                                <VisualState x:Name="Struck"/>
                                <VisualState x:Name="Striking">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.35"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="Cap" Height="26" MinWidth="46">
                            <!-- The cap's shadow and, lit, its outer glow in the colour PART_OuterGlow carries for
                                 the state; then, over the face, the glow round the word (Lamp.cs). -->
                            <Border x:Name="PART_ShadowHost" IsHitTestVisible="False"/>
                            <Border x:Name="PART_OuterGlow" Visibility="Collapsed"/>
                            <Border x:Name="Face" BorderThickness="1" CornerRadius="{StaticResource CapCornerRadius}"
                                    Background="{ThemeResource LampFaceBrush}" BorderBrush="{ThemeResource LampEdgeBrush}"/>
                            <Border x:Name="Glow" Margin="1" BorderThickness="2" CornerRadius="{StaticResource InsetCornerRadius}"/>
                            <Border Height="1" Margin="1,1,1,0" VerticalAlignment="Top" Background="{ThemeResource LampLipBrush}"/>
                            <Border Height="1" Margin="1,0,1,1" VerticalAlignment="Bottom" Background="{ThemeResource LampUnderBrush}"/>
                            <Border x:Name="PART_WordGlowHost" IsHitTestVisible="False"/>
                            <TextBlock x:Name="Word" Margin="9,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource ConsoleLampFontFamily}" FontSize="10.5" CharacterSpacing="100"
                                       Foreground="{ThemeResource LampOffForegroundBrush}" Text="{TemplateBinding Code}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ LED DOT (:1792-1828) -->

    <!-- A 7-across LED in its state's colour; unlit, it is graphite. Lit, it has a halo drawn behind it
         (LedDot.cs). Warn blinks at 1 Hz; Pulsing breathes to 55% and back over 2 seconds, the ON AIR light
         (:469-478). -->
    <Style TargetType="instruments:LedDot">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:LedDot">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DotStates">
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="Go">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedGoBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Hold">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedHoldBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Warn">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedWarnBrush}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                                       Duration="0:0:1" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.18"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="WarnSteady">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedWarnBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NoGo">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedNoGoBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Exec">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource LedScopeBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Armed">
                                    <VisualState.Setters>
                                        <Setter Target="Light.Fill" Value="{ThemeResource ArmedDisplayBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PulseStates">
                                <VisualState x:Name="Steady"/>
                                <VisualState x:Name="Pulsing">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity"
                                                                       Duration="0:0:2" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.55">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_GlowHost" IsHitTestVisible="False"/>
                        <Ellipse x:Name="Light" Fill="{ThemeResource GraphiteBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ LCD (:1831-1892) -->

    <!-- A void-black window in a black edge, shaded from the top, with a glint along its lower lip and a cover
         glass over the lot: the caption in silkscreen, the reading in phosphor with its glow behind it (Lcd.cs),
         its unit smaller and quieter. The tone changes the reading's colour and nothing else. -->
    <Style TargetType="instruments:Lcd">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:Lcd">
                    <Border BorderThickness="1" CornerRadius="{StaticResource PlateCornerRadius}"
                            Background="{ThemeResource DisplayFaceBrush}" BorderBrush="{ThemeResource DisplayBorderBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ToneStates">
                                <VisualState x:Name="Go"/>
                                <VisualState x:Name="Amber">
                                    <VisualState.Setters>
                                        <Setter Target="ValueText.Foreground" Value="{ThemeResource LedHoldBrush}"/>
                                        <Setter Target="UnitText.Foreground" Value="{ThemeResource LedHoldBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Red">
                                    <VisualState.Setters>
                                        <Setter Target="ValueText.Foreground" Value="{ThemeResource ArmedDisplayBrush}"/>
                                        <Setter Target="UnitText.Foreground" Value="{ThemeResource ArmedDisplayBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Scope">
                                    <VisualState.Setters>
                                        <Setter Target="ValueText.Foreground" Value="{ThemeResource LedScopeBrush}"/>
                                        <Setter Target="UnitText.Foreground" Value="{ThemeResource LedScopeBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NoGo">
                                    <VisualState.Setters>
                                        <Setter Target="ValueText.Foreground" Value="{ThemeResource LedNoGoBrush}"/>
                                        <Setter Target="UnitText.Foreground" Value="{ThemeResource LedNoGoBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="UnitStates">
                                <VisualState x:Name="HasUnit"/>
                                <VisualState x:Name="NoUnit">
                                    <VisualState.Setters>
                                        <Setter Target="UnitText.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border Height="7" VerticalAlignment="Top" Background="{ThemeResource DisplayShadeTopBrush}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource WellLipBrush}"/>
                            <StackPanel Padding="10,8" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource LcdLabelTextStyle}" Text="{TemplateBinding Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <Border x:Name="PART_ValueGlowHost" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="ValueText" Style="{StaticResource LcdValueTextStyle}" Text="{TemplateBinding Value}"/>
                                    </Grid>
                                    <TextBlock x:Name="UnitText" Margin="4,0,0,2" VerticalAlignment="Bottom" Opacity="0.7"
