            <Setter.Value>
                <ControlTemplate TargetType="instruments:StandbyPanel">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActionStates">
                                <VisualState x:Name="NoAction"/>
                                <VisualState x:Name="HasAction">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Action.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <instruments:Faceplate Padding="32,48" Kicker="{TemplateBinding Kicker}" Serial="{TemplateBinding SerialText}">
                            <instruments:Faceplate.StripeRight>
                                <instruments:Lamp State="Exec" Code="STBY" Size="Small" AutomationProperties.Name="STBY, standing by"/>
                            </instruments:Faceplate.StripeRight>
                            <StackPanel HorizontalAlignment="Center">
                                <instruments:Well Width="64" Height="64" HorizontalAlignment="Center"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <FontIcon FontSize="28" Foreground="{ThemeResource DisplayFgMuteBrush}" Glyph="{TemplateBinding Glyph}"/>
                                </instruments:Well>
                                <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           FontFamily="{StaticResource ConsoleBodySemiBoldFontFamily}" FontWeight="SemiBold"
                                           FontSize="16" LineHeight="20.8" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{ThemeResource PlatinumBrush}" Text="{TemplateBinding Title}"/>
                                <TextBlock Margin="0,8,0,0" MaxWidth="405" HorizontalAlignment="Center" TextAlignment="Center"
                                           Style="{StaticResource DescriptionTextStyle}" Text="{TemplateBinding Description}"/>
                                <Button x:Name="PART_Action" Margin="0,24,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                        Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"/>
                            </StackPanel>
                        </instruments:Faceplate>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ VIEW HEADER (ViewHeader.tsx) -->

    <!-- A faceplate with the module's kicker and serial in its stripe and the page's status at the stripe's right.
         In its body, the placard - the title in capitals, a level-one heading - over the description, 6 below it,
         68 characters wide at most; the actions sit at the right, level with the foot of the text. -->
    <Style TargetType="instruments:ViewHeader">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="instruments:ViewHeader">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DescriptionStates">
                                <VisualState x:Name="NoDescription"/>
                                <VisualState x:Name="HasDescription">
                                    <VisualState.Setters>
                                        <Setter Target="DescriptionText.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <instruments:Faceplate Kicker="{TemplateBinding KickerText}" Serial="{TemplateBinding SerialText}"
                                               StripeRight="{TemplateBinding Status}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource ViewTitleTextStyle}" TextWrapping="Wrap"
                                               AutomationProperties.HeadingLevel="Level1" Text="{TemplateBinding TitleText}"/>
                                    <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" MaxWidth="530" HorizontalAlignment="Left"
                                               Visibility="Collapsed" Style="{StaticResource DescriptionTextStyle}"
                                               Text="{TemplateBinding Description}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" VerticalAlignment="Bottom" IsTabStop="False"
                                                Content="{TemplateBinding Actions}"/>
                            </Grid>
                        </instruments:Faceplate>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
