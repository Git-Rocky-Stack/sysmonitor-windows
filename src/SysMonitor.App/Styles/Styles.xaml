<?xml version="1.0" encoding="utf-8"?>
<!--
    The first generation's style names, kept because the pages ask for them by name, and now answered by the Command
    Console. Nothing here draws a look of its own: each style is a console text style from Typography.xaml or a
    recipe on the palette's tokens, so a page that still says PageHeaderStyle gets the view title. The look lives in
    the console and is changed there; this file only maps old names onto it, and every name in it has a page asking
    for it. The card styles are gone: every card is now the Plate instrument, which draws the lip, shade and shadow
    a styled Border could not.

    Colours are asked for with {ThemeResource}, never written here, so every style follows the shift it is shown in.
    A page moving onto the console's own names (ViewTitleTextStyle, a Plate, a Faceplate) can drop the old one; the
    mapping is the bridge, not the destination.

    Sources are System-X's stylesheet at system-x-app@eaba14b.

      PageHeaderStyle    .view-title (:1659), as ViewTitleTextStyle sets it.
      AccentBarStyle     the plate's light pipe - 3 wide, armed (:1149) - beside a sub-heading inside a panel. A
                         page's major sections are Faceplates, whose stripe carries the section's kicker.
      StatLabelStyle     .kicker (:1642); StatValueStyle and LargeStatValueStyle the telemetry face (:2569).
      CardTitleStyle     a heading (:926-935), never Archivo caps; CardSubtitleStyle a description.
      progress bars      the console's LED meter (Controls.xaml), lit in the colour that names the meter's job.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ ICON SEATS -->

    <!-- An icon's seat: the chip's flatter cap face (:2176) on the control radius. -->
    <Style x:Key="IconContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ChipFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CapEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CapCornerRadius}"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="IconContainerRedStyle" TargetType="Border" BasedOn="{StaticResource IconContainerStyle}"/>

    <Style x:Key="MenuCardIconStyle" TargetType="Border" BasedOn="{StaticResource IconContainerStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============================================================ TITLES AND PLACARDS -->

    <Style x:Key="PageHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ViewTitleTextStyle}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}">
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>

    <Style x:Key="AccentBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArmedBrush}"/>
        <Setter Property="Width" Value="3"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ============================================================ TEXT -->

    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Heading2TextStyle}"/>

    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}"/>

    <Style x:Key="MenuItemTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Heading2TextStyle}"/>

    <Style x:Key="MenuItemSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}"/>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource KickerTextStyle}"/>

    <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TelemetryTextStyle}">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Foreground" Value="{ThemeResource PlatinumBrush}"/>
    </Style>

    <Style x:Key="LargeStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ReadoutTextStyle}">
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="LineHeight" Value="64"/>
        <Setter Property="Foreground" Value="{ThemeResource StateGoBrush}"/>
    </Style>

    <Style x:Key="StatusGoodStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleBodySemiBoldFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource StateGoBrush}"/>
    </Style>

    <!-- ============================================================ METERS -->

    <!-- Each is the console's LED meter (Controls.xaml) in one colour, at the old meters' height. -->
    <Style x:Key="RedProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource ConsoleMeterProgressBarStyle}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{ThemeResource ArmedBrush}"/>
    </Style>

    <Style x:Key="GreenProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource RedProgressBarStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LedGoBrush}"/>
    </Style>

    <Style x:Key="CyanProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource RedProgressBarStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LedScopeBrush}"/>
    </Style>

    <Style x:Key="PremiumProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource RedProgressBarStyle}">
        <Setter Property="Height" Value="12"/>
    </Style>
</ResourceDictionary>
